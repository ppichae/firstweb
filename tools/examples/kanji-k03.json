[
{"c":"愛","m":"사랑, 사랑하다","s":"마음(心)을 덮개(冖) 아래 소중히 품고 천천히 걷는다(夂) → '사랑'."},
{"c":"用","m":"쓰다, 볼일, 용도","s":"울타리 가운데 기둥을 세워 '쓴다'."},
{"c":"者","m":"사람, ~하는 사람","s":"늙은이(耂)가 날(日)마다 일하는 '사람'."},
{"c":"絶","m":"끊다, 끊어지다, 절대","s":"실(糸)을 칼처럼 색(色)이 바뀌는 곳에서 '끊는다'."},
{"c":"対","m":"마주하다, 대하다, 짝","s":"글(文) 옆에 손(寸)을 들고 '마주한다'."},
{"c":"校","m":"학교","s":"나무(木) 아래 모여 사귀는(交) 곳 → '학교'."},
{"c":"遊","m":"놀다","s":"길(辶)에서 깃발 아래 아이(子)가 '논다'."},
{"c":"休","m":"쉬다","s":"사람(亻)이 나무(木)에 기대어 '쉰다'."},
{"c":"支","m":"버티다, 지탱하다, 지점","s":"손(又)으로 나뭇가지(十)를 받쳐 '버틴다'."},
{"c":"給","m":"주다, 급여","s":"실(糸)을 모아(合) 나누어 '준다' → '급여'."},
{"c":"自","s":"코를 가리키며 '나'라고 하는 모양 → '스스로'."},
{"c":"秒","m":"초(시간)","s":"벼(禾)의 아주 적은(少) 끝 → 시간의 아주 작은 단위 '초'."},
{"c":"残","s":"창(戈)이 지나간 뒤 뼈(歹)만 '남는다'."},
{"c":"増","m":"늘다, 늘리다","s":"흙(土)을 겹겹이(曽) 쌓아 '늘린다'."},
{"c":"生","m":"나다, 살다, 날것","s":"땅 위로 싹이 돋아 '난다', '산다'."},
{"c":"娘","m":"딸, 아가씨","s":"착한(良) 여자(女) → '딸'."},
{"c":"預","m":"맡기다, 맡다","s":"미리(予) 머리(頁) 숙여 '맡긴다'."},
{"c":"無","m":"없다","s":"불(灬)에 다 타 버려 아무것도 '없다'."},
{"c":"駄","m":"쓸데없음, 나쁜 것(駄目 등)","s":"말(馬)에 크게(太) 실은 짐이 '쓸데없이' 무겁다."},
{"c":"土","m":"흙, 땅","s":"땅 위에 흙더미가 솟은 모양 → '흙'."},
{"c":"志","m":"뜻, 뜻하다","s":"선비(士)의 마음(心)에 품은 '뜻'."},
{"c":"疲","m":"지치다, 피곤하다","s":"병(疒)난 듯 가죽(皮)까지 늘어져 '지친다'."},
{"c":"触","m":"닿다, 만지다","s":"뿔(角)에 벌레(虫)가 '닿는다'."},
{"c":"機","m":"기계, 기회, 틀","s":"나무(木)로 짠 베틀 → '기계', 딱 맞는 때 '기회'."},
{"c":"納","m":"넣다, 바치다, 납부하다","s":"실(糸)을 안(内)으로 '거두어 넣는다'."},
{"c":"抜","m":"뽑다, 빠지다, 빼다","s":"손(扌)으로 쑥 '뽑는다'."},
{"c":"見","s":"사람(儿) 위에 큰 눈(目) → '보다'."},
{"c":"岩","m":"바위","s":"산(山) 위의 돌(石) → '바위'."},
{"c":"勤","m":"근무하다, 부지런하다","s":"진흙(堇) 같은 힘든 일에 힘(力)을 쏟아 '근무한다'."},
{"c":"表","s":"털(毛)이 겉으로 드러난 옷(衣) → '겉, 나타내다'."},
{"c":"息","m":"숨, 쉬다, 자식","s":"코(自)와 마음(心)으로 '숨'을 쉰다."},
{"c":"失","m":"잃다, 실수","s":"손에서 물건이 빠져나가 '잃는다'."},
{"c":"組","m":"짜다, 조, 반","s":"실(糸)을 또(且) 엮어 '짠다' → '조, 반'."},
{"c":"順","m":"순서, 순하다","s":"냇물(川)처럼 머리(頁)를 숙이고 따르는 '순서'."},
{"c":"苦","m":"괴롭다, 쓰다(맛)","s":"풀(艹)이 오래(古)되어 맛이 '쓰다', '괴롭다'."},
{"c":"労","m":"일하다, 수고","s":"불꽃(⺌)처럼 힘(力)을 쏟는 '수고'."},
{"c":"応","m":"응하다, 대답하다","s":"집(广) 안에서 마음(心)으로 '응한다'."},
{"c":"首","m":"목, 머리, 우두머리","s":"머리털 아래 코(自)가 있는 '머리' → '목'."},
{"c":"都","m":"도시, 수도, 모두","s":"사람들(者)이 모인 마을(⻏) → '도시'."},
{"c":"語","m":"말, 이야기하다","s":"나(吾)의 말(言) → '말, 언어'."},
{"c":"球","m":"공, 구","s":"구슬(王)을 구하듯(求) 둥근 '공'."},
{"c":"協","m":"힘을 합하다, 협력","s":"열(十) 사람이 힘(力)을 셋이나 합친다 → '협력'."},
{"c":"問","m":"묻다, 문제","s":"문(門) 앞에서 입(口)으로 '묻는다'."},
{"c":"到","m":"이르다, 도착하다","s":"칼(刂)을 차고 목적지(至)에 '이른다'."},
{"c":"値","m":"값, 가치","s":"사람(亻)이 곧게(直) 매긴 '값'."},
{"c":"段","m":"단, 계단, 단계","s":"몽둥이(殳)로 다듬은 층층이 '계단'."},
{"c":"深","m":"깊다","s":"물(氵) 속을 손으로 더듬어 찾을 만큼 '깊다'."},
{"c":"汗","m":"땀","s":"물(氵)처럼 몸을 범하며(干) 흐르는 '땀'."},
{"c":"島","m":"섬","s":"새(鳥)가 바다 가운데 산(山)에 앉는 '섬'."},
{"c":"卒","m":"마치다, 졸업","s":"열(十) 사람(人人)이 끝까지 '마친다'."},
{"c":"固","m":"굳다, 단단하다","s":"오래된(古) 것을 상자(囗)에 가두니 '굳는다'."},
{"c":"他","m":"다른, 남","s":"사람(亻) 옆의 다른 것(也) → '남, 다른'."},
{"c":"示","m":"보이다, 가리키다","s":"제단 위에 놓아 '보여 준다'."},
{"c":"科","m":"과, 과목","s":"벼(禾)를 말(斗)로 나누듯 갈래를 나눈 '과'."},
{"c":"以","m":"~로써, 이(以上·以下)","s":"사람(人)이 쟁기를 '가지고' 일한다 → '~로써'."},
{"c":"張","m":"펴다, 당기다, 붙이다","s":"활(弓)을 길게(長) 당겨 '편다'."},
{"c":"根","m":"뿌리, 근본, 끈기","s":"나무(木)가 멈추어(艮) 내린 '뿌리'."},
{"c":"事","m":"일, 것","s":"손에 붓을 쥐고 하는 '일'."},
{"c":"各","m":"각각","s":"걸어온(夂) 사람마다 입(口)이 하나씩 → '각각'."},
{"c":"貯","m":"모으다, 저축하다","s":"돈(貝)을 우뚝(宁) 쌓아 '모은다'."},
{"c":"金","s":"흙(土) 속에 반짝이는 점들 → '쇠, 금, 돈'."},
{"c":"章","m":"글, 장(章), 표시","s":"소리(音)를 열(十) 줄로 끝맺은 '글의 한 장'."},
{"c":"改","m":"고치다","s":"몸(己)을 회초리(攵)로 다잡아 '고친다'."},
{"c":"札","m":"표, 지폐, 패","s":"나무(木) 조각에 글자를 새긴 '표'."},
{"c":"商","m":"장사, 상업","s":"높은 곳에 서서 물건을 외치며 파는 '장사'."},
{"c":"相","m":"서로, 상대, 모습","s":"나무(木)를 눈(目)으로 마주 본다 → '서로'."},
{"c":"食","m":"먹다, 밥","s":"뚜껑(𠆢) 아래 좋은(良) 밥 → '먹다'."},
{"c":"厚","m":"두껍다, 두텁다","s":"언덕(厂) 아래 해(日)가 쌓인 아이(子)처럼 '두껍다'."},
{"c":"美","m":"아름답다","s":"크고(大) 살진 양(羊) → '아름답다'."},
{"c":"創","m":"처음 만들다, 창조","s":"곳간(倉)의 나무를 칼(刂)로 처음 다듬어 '만든다'."},
{"c":"造","m":"만들다, 짓다","s":"길(辶)에 나아가 알리며(告) 집을 '짓는다'."},
{"c":"営","m":"경영하다, 운영하다","s":"불꽃(⺌) 아래 지붕 밑에서 밤새 일을 '꾸린다'."},
{"c":"分","m":"나누다, 분, 알다","s":"칼(刀)로 여덟(八) 조각을 '나눈다'."},
{"c":"液","m":"액체, 즙","s":"물(氵)이 밤(夜)새 맺힌 '액체'."},
{"c":"湖","m":"호수","s":"물(氵)이 오랫동안(古) 달(月)빛을 담은 '호수'."},
{"c":"荷","m":"짐","s":"풀(艹) 다발을 어찌(何) 다 지나 하는 '짐'."},
{"c":"丸","m":"둥글다, 알, 온전히","s":"둥글게 웅크린 사람 모양 → '둥글다'."},
{"c":"個","m":"개, 낱개, 개인","s":"사람(亻)이 굳게(固) 혼자 서 있다 → '낱개'."},
{"c":"申","m":"말하다(겸손), 신청하다","s":"번개가 위아래로 뻗듯 말씀을 '아뢴다'."},
{"c":"独","m":"홀로, 독일","s":"개(犭)와 벌레(虫)가 각자 '혼자' 논다."},
{"c":"立","m":"서다, 세우다","s":"땅(一) 위에 두 팔 벌린 사람이 '선다'."},
{"c":"観","m":"보다, 관찰하다","s":"황새가 목을 빼고 잘 '본다(見)'."},
{"c":"客","m":"손님","s":"집(宀)에 각각(各) 찾아온 '손님'."},
{"c":"払","m":"치르다, 털다, 지불하다","s":"손(扌)으로 작은 것(厶)을 털어 '치른다'."},
{"c":"豆","m":"콩","s":"굽 달린 그릇 모양 → 그 안의 '콩'."},
{"c":"税","m":"세금","s":"벼(禾)를 바꾸어(兑) 나라에 내는 '세금'."},
{"c":"品","m":"물건, 품격","s":"상자(口) 세 개를 쌓아 둔 '물건'."},
{"c":"下","m":"아래, 내리다","s":"선(一) 아래로 점이 매달린 '아래'."},
{"c":"線","m":"선, 줄","s":"실(糸)이 샘(泉)물처럼 길게 이어진 '선'."},
{"c":"主","m":"주인, 주로","s":"등잔 위에 불꽃(丶)이 선 모양 → 집의 '주인'."},
{"c":"要","m":"필요하다, 요점","s":"서쪽(西) 아래 여자(女)의 허리처럼 '중요한' 곳."},
{"c":"直","m":"곧다, 고치다, 바로","s":"열(十) 개의 눈(目)으로 보니 '곧다'."},
{"c":"接","m":"잇다, 접하다","s":"손(扌)으로 첩(妾)의 손을 맞잡아 '잇는다'."},
{"c":"燃","m":"타다, 태우다","s":"불(火)이 그러하게(然) 활활 '탄다'."},
{"c":"位","m":"자리, 위치, 등위","s":"사람(亻)이 서는(立) '자리'."},
{"c":"置","m":"두다, 놓다","s":"그물(罒) 아래 곧게(直) '둔다'."},
{"c":"回","m":"돌다, 번, 회","s":"네모 안에 네모가 빙글빙글 '돈다'."},
{"c":"禁","m":"금하다","s":"숲(林)의 제단(示)에는 함부로 못 들어가게 '금한다'."},
{"c":"結","m":"맺다, 묶다","s":"실(糸)을 길하게(吉) 꽁꽁 '맺는다'."},
{"c":"術","m":"기술, 방법","s":"갈림길(行)에서 차조(朮)처럼 길을 찾는 '기술'."},
{"c":"績","m":"성적, 공적","s":"실(糸)을 꾸준히 쌓아(責) 올린 '성과'."},
{"c":"専","m":"오로지, 전문","s":"실패에 손(寸)으로 실을 감듯 한 가지만 '오로지'."},
{"c":"門","m":"문","s":"좌우로 열리는 두 짝 '문'."},
{"c":"温","m":"따뜻하다, 온도","s":"물(氵)을 그릇(皿)에 담아 해(日)에 데우니 '따뜻하다'."},
{"c":"健","m":"건강하다, 굳세다","s":"사람(亻)이 세우듯(建) 몸을 '튼튼히' 한다."},
{"c":"康","m":"편안하다, 건강","s":"집(广) 아래 쌀을 넉넉히 두니 몸이 '편안하다'."},
{"c":"量","m":"양, 헤아리다","s":"해(日) 아래 마을(里)의 곡식을 '헤아린다'."},
{"c":"光","m":"빛, 빛나다","s":"사람(儿) 머리 위로 불꽃이 퍼진다 → '빛'."},
{"c":"券","m":"표, 권","s":"칼(刀)로 반을 잘라 나눠 갖는 '표'."},
{"c":"誌","m":"잡지, 기록","s":"말(言)과 뜻(志)을 모아 적은 '잡지'."},
{"c":"原","m":"근원, 들판, 원래","s":"언덕(厂) 아래 샘(泉)이 솟는 '근원'."},
{"c":"歯","m":"이, 치아","s":"입 안에 멈춘(止) 듯 늘어선 '이'."},
{"c":"倍","m":"배, 곱","s":"사람(亻)이 갈라(咅) 두 배로 늘린다 → '곱'."},
{"c":"停","m":"멈추다, 정지","s":"사람(亻)이 정자(亭) 앞에서 '멈춘다'."},
{"c":"電","m":"전기, 번개","s":"비(雨) 사이로 번개(申 모양)가 친다 → '전기'."},
{"c":"貸","m":"빌려주다","s":"돈(貝)을 대신(代) 내주니 '빌려준다'."},
{"c":"若","m":"젊다, 만약","s":"풀(艹)을 오른손(右)으로 뜯는 '젊은' 사람."},
{"c":"泉","m":"샘","s":"하얀(白) 물(水)이 솟는 '샘'."},
{"c":"雑","m":"섞이다, 잡다하다","s":"새(隹)들이 아홉(九) 그루 나무(木)에 뒤섞여 '어수선하다'."},
{"c":"仮","m":"임시, 거짓, 가정","s":"사람(亻)이 뒤집어(反) 꾸민 '임시' 모습."},
{"c":"関","m":"관계, 관문","s":"문(門)에 빗장을 걸어 '관계'를 잇는다."},
{"c":"投","m":"던지다","s":"손(扌)으로 몽둥이(殳)를 '던진다'."},
{"c":"因","m":"원인, 말미암다","s":"상자(囗) 안에 큰(大) 사람이 누운 '까닭'."},
{"c":"借","m":"빌리다","s":"사람(亻)이 옛날(昔)처럼 다시 '빌린다'."},
{"c":"緑","m":"초록, 녹색","s":"실(糸)을 풀물에 담가 '초록'으로 물들인다."},
{"c":"願","m":"바라다, 원하다","s":"근원(原)에서 머리(頁) 숙여 '바란다'."},
{"c":"波","m":"파도, 물결","s":"물(氵)의 가죽(皮)이 일어난 '물결'."},
{"c":"速","m":"빠르다, 속도","s":"길(辶)을 묶은(束) 짐을 들고도 '빠르다'."},
{"c":"満","m":"차다, 가득하다","s":"물(氵)이 그릇에 '가득 찬다'."},
{"c":"足","m":"발, 다리, 충분하다","s":"무릎(口) 아래 멈춘 발(止) → '발', 그리고 '넉넉하다'."},
{"c":"輸","m":"나르다, 보내다","s":"수레(車)에 싣고 '보낸다' → '수출·수입'."},
{"c":"眠","m":"자다, 졸리다","s":"눈(目)을 감고 백성(民)처럼 '잔다'."},
{"c":"頭","m":"머리, 우두머리","s":"콩(豆)처럼 둥근 머리(頁) → '머리'."},
{"c":"葉","m":"잎","s":"풀(艹) 아래 나무(木)에 달린 '잎'."},
{"c":"待","m":"기다리다","s":"걸어가다(彳) 절(寺) 앞에서 '기다린다'."},
{"c":"飛","m":"날다","s":"새가 두 날개를 펴고 '난다'."},
{"c":"違","m":"다르다, 틀리다, 어기다","s":"길(辶)에서 서로 등을 돌려(韋) 가니 '다르다'."},
{"c":"係","m":"관계하다, 담당","s":"사람(亻)이 실(系)로 이어져 '관계한다' → '담당'."},
{"c":"師","m":"스승, 전문가","s":"언덕(𠂤)에 천(巾)을 두른 '스승'."},
{"c":"賃","m":"삯, 요금","s":"맡긴(任) 일에 주는 돈(貝) → '삯'."},
{"c":"新","m":"새롭다, 새","s":"서 있는(立) 나무(木)를 도끼(斤)로 막 베어 '새롭다'."},
{"c":"派","m":"파, 갈래, 보내다","s":"물(氵)이 갈라져 흐르는 '갈래' → '파'."},
{"c":"泡","m":"거품","s":"물(氵)을 싸서(包) 만든 '거품'."},
{"c":"半","m":"반, 절반","s":"소(牛)를 위에서 반으로 가르는 '반'."},
{"c":"扱","m":"다루다, 취급하다","s":"손(扌)이 미치는(及) 대로 '다룬다'."},
{"c":"体","m":"몸, 몸체","s":"사람(亻)의 근본(本) → '몸'."},
{"c":"書","m":"쓰다, 글, 책","s":"붓(聿)으로 해(日)처럼 또렷이 '쓴다'."},
{"c":"両","m":"둘, 양쪽","s":"저울 양쪽에 같은 추가 달린 '양쪽'."},
{"c":"前","m":"앞, 전","s":"배 앞머리에서 칼(刂)로 물살을 가르며 '앞'으로."},
{"c":"後","m":"뒤, 나중","s":"걸음(彳)이 작게(幺) 느려져(夂) '뒤'처진다."},
{"c":"起","m":"일어나다, 일으키다","s":"달려갈(走) 몸(己)이 벌떡 '일어난다'."},
{"c":"援","m":"돕다, 응원","s":"손(扌)으로 끌어당겨 '돕는다'."},
{"c":"代","m":"대신하다, 대(세대), 요금","s":"사람(亻)이 말뚝(弋)을 '대신' 세운다."},
{"c":"片","m":"조각, 한쪽","s":"나무를 반으로 쪼갠 한쪽 → '조각'."},
{"c":"閉","m":"닫다","s":"문(門)에 빗장(才)을 걸어 '닫는다'."},
{"c":"突","m":"찌르다, 갑자기","s":"구멍(穴)에서 개(犬)가 '갑자기' 튀어나온다."},
{"c":"引","m":"끌다, 당기다","s":"활(弓)을 줄(丨)로 '당긴다'."},
{"c":"受","m":"받다","s":"위의 손(爫)이 주고 아래 손(又)이 '받는다'."},
{"c":"祝","m":"축하하다, 빌다","s":"제단(礻) 앞에서 형(兄)이 '축하'의 말을 한다."},
{"c":"積","m":"쌓다, 쌓이다","s":"벼(禾)를 꾸준히 책임(責)지고 '쌓는다'."},
{"c":"印","m":"도장, 표시","s":"손으로 사람(卩)을 꾹 눌러 찍는 '도장'."},
{"c":"象","m":"코끼리, 모양","s":"긴 코와 큰 몸의 '코끼리' → '모양'."},
{"c":"使","m":"쓰다, 부리다","s":"사람(亻)에게 관리(吏)가 일을 '시킨다'."},
{"c":"飽","m":"싫증 나다, 물리다","s":"먹고(食) 배를 감싸(包) 쥘 만큼 먹어 '질린다'."},
{"c":"標","m":"표시, 목표","s":"나무(木)에 표(票)를 달아 '표시'한다."}
]
