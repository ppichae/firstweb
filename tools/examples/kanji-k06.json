[
{"c":"拓","m":"개척하다, 넓히다","s":"손(扌)으로 돌(石)을 치우며 땅을 '넓힌다'."},
{"c":"怠","m":"게으르다, 게을리하다","s":"마음(心)이 늘어져(台) '게으르다'."},
{"c":"了","m":"마치다, 끝내다(完了)","s":"실 끝을 매듭지은 모양 → '끝낸다'."},
{"c":"巡","m":"돌다, 순회하다","s":"길(辶)을 냇물(巛)처럼 굽이굽이 '돈다'."},
{"c":"顧","m":"돌아보다, 고객","s":"머리(頁)를 돌려 '돌아본다'."},
{"c":"偽","m":"거짓, 가짜, 속이다","s":"사람(亻)이 하는(為) 척만 하니 '가짜'."},
{"c":"嫌","m":"싫어하다, 싫다","s":"여자(女)가 둘을 겸해야(兼) 하니 '싫다'."},
{"c":"粛","m":"엄숙하다, 조용히","s":"붓(聿)을 들고 조용히 앉아 '엄숙하다'."},
{"c":"丘","m":"언덕","s":"땅 위에 낮게 솟은 두 봉우리 → '언덕'."},
{"c":"陵","m":"언덕, 큰 무덤","s":"언덕(⻖)을 넘어 오르는 높은 '무덤'."},
{"c":"豪","m":"호걸, 호화롭다, 굉장하다","s":"높은(高) 털 돼지(豕)처럼 기세가 '굉장하다'."},
{"c":"忍","m":"참다, 견디다","s":"마음(心) 위에 칼날(刃)을 얹고도 '참는다'."},
{"c":"耐","m":"견디다","s":"수염(而)을 잡혀도 손(寸)을 꽉 쥐고 '견딘다'."},
{"c":"膨","m":"부풀다, 팽창하다","s":"몸(月)이 북처럼 '부푼다'."},
{"c":"驚","m":"놀라다, 놀라게 하다","s":"말(馬)이 공경(敬)할 만큼 깜짝 '놀란다'."},
{"c":"嘆","m":"탄식하다, 한탄하다","s":"입(口)으로 '아아' 하고 '탄식한다'."},
{"c":"猛","m":"사납다, 맹렬하다","s":"개(犭)가 맏이(孟)처럼 '사납다'."},
{"c":"崩","m":"무너지다, 무너뜨리다","s":"산(山)이 벗(朋)처럼 나란히 '무너진다'."},
{"c":"殖","m":"불어나다, 번식하다","s":"뼈(歹) 옆에 곧게(直) 새 생명이 '불어난다'."},
{"c":"履","m":"신다, 밟다, 이력","s":"몸(尸)이 다시(復) 걸으려 신을 '신는다'."},
{"c":"歴","m":"지나다, 역사, 경력","s":"언덕(厂) 아래 벼를 줄지어 두고 해마다 '지나간다'."},
{"c":"映","m":"비치다, 비추다, 영화","s":"해(日)가 가운데(央)를 '비춘다'."},
{"c":"披","m":"헤치다, 펴 보이다(披露)","s":"손(扌)으로 가죽(皮)을 '펼쳐 보인다'."},
{"c":"砕","m":"부수다, 부서지다","s":"돌(石)을 끝(卆)까지 '부순다'."},
{"c":"執","m":"잡다, 집행하다, 고집","s":"손을 붙잡아 꼼짝 못 하게 '잡는다'."},
{"c":"債","m":"빚, 채무","s":"사람(亻)이 책임(責)지는 '빚'."},
{"c":"務","m":"일, 힘쓰다, 업무","s":"창(矛)을 들고 힘(力)써 맡은 '일'."},
{"c":"渉","m":"건너다, 관계하다(交渉)","s":"물(氵)을 걸어(歩) '건넌다'."},
{"c":"措","s":"손(扌)으로 옛(昔)것을 제자리에 '둔다' → '조치'."},
{"c":"叫","m":"외치다, 부르짖다","s":"입(口)으로 소리를 꼬아(丩) 크게 '외친다'."},
{"c":"背","m":"등, 키, 배반하다","s":"북쪽(北)으로 돌아선 몸(月) → '등'."},
{"c":"負","m":"지다(패배), 짊어지다, 빚","s":"사람(⺈)이 돈(貝)을 '짊어진다' → '지다'."},
{"c":"侮","m":"얕보다, 업신여기다","s":"사람(亻)이 매번(毎) 남을 '얕본다'."},
{"c":"奔","m":"달리다, 분주하다","s":"큰(大) 사람이 풀밭을 '달린다'."},
{"c":"放","m":"놓다, 풀어 주다, 방송","s":"사방(方)으로 회초리(攵)를 휘둘러 '풀어 놓는다'."},
{"c":"円","m":"엔(돈), 원, 둥글다","s":"둥근 동전 모양 → '엔, 둥글다'."},
{"c":"及","m":"미치다, 이르다, 및","s":"앞사람에게 손(又)이 닿아 '미친다'."},
{"c":"束","m":"묶다, 다발, 약속","s":"나무(木)를 끈(口)으로 '묶는다'."},
{"c":"音","m":"소리","s":"서서(立) 해(日)처럼 울려 퍼지는 '소리'."},
{"c":"綿","m":"솜, 면","s":"실(糸)과 하얀(白) 천(巾) → '솜'."},
{"c":"粋","s":"쌀(米)을 끝(卆)까지 골라 '순수하다', 그리고 '세련됨'."},
{"c":"備","m":"갖추다, 준비하다","s":"사람(亻)이 화살통을 미리 '갖춘다'."},
{"c":"謀","m":"꾀하다, 음모","s":"말(言)로 무엇(某)을 몰래 '꾀한다'."},
{"c":"訂","m":"바로잡다, 정정하다","s":"말(言)을 못(丁) 박듯 '바로잡는다'."},
{"c":"版","m":"판, 출판","s":"나무 조각(片)을 뒤집어(反) 찍는 '판'."},
{"c":"遽","m":"급하다, 갑자기(急遽)","s":"길(辶)에서 호랑이(虍)를 만나 '급히' 달아난다."},
{"c":"究","m":"연구하다, 끝까지 파고들다","s":"구멍(穴) 끝까지 아홉(九) 번 파고들어 '연구한다'."},
{"c":"妥","s":"손(爫)으로 여자(女)를 달래 '타협한다'."},
{"c":"催","m":"열다(개최), 재촉하다","s":"사람(亻)이 산(山) 위 새(隹)를 몰듯 '재촉한다' → '개최'."},
{"c":"腕","m":"팔, 솜씨","s":"몸(月)에서 굽어지는 곳 → '팔', 그리고 '솜씨'."},
{"c":"硬","m":"딱딱하다, 굳다","s":"돌(石)처럼 다시(更) 굳어 '딱딱하다'."},
{"c":"障","m":"막다, 지장, 장애","s":"언덕(⻖)이 글(章)을 가로막아 '지장'이 생긴다."},
{"c":"色","m":"색, 빛깔","s":"사람이 몸을 기대 얼굴빛이 바뀌는 '색'."},
{"c":"駆","m":"몰다, 달리다","s":"말(馬)을 구역(区)으로 '몰아 달린다'."},
{"c":"揺","m":"흔들리다, 흔들다","s":"손(扌)으로 '흔든다'."},
{"c":"該","m":"해당하다, 그","s":"말(言)이 돼지(亥)까지 딱 '해당한다'."},
{"c":"稼","m":"벌다, 일하다","s":"벼(禾)를 집(家)으로 들여 돈을 '번다'."},
{"c":"幅","m":"폭, 너비","s":"천(巾)이 가득(畐) 펼쳐진 '폭'."},
{"c":"掃","m":"쓸다, 청소하다","s":"손(扌)에 빗자루(帚)를 들고 '쓴다'."},
{"c":"盤","m":"판, 바탕, 소반","s":"배(舟)처럼 넓은 그릇(皿) → '판'."},
{"c":"尽","m":"다하다, 다 쓰다","s":"자(尺)의 끝까지 점(冫)을 찍어 '다한다'."},
{"c":"頻","s":"걸음(歩)을 멈출 새 없이 머리(頁)를 '자주' 숙인다."},
{"c":"庫","m":"창고","s":"집(广) 안에 수레(車)를 넣어 두는 '창고'."},
{"c":"堅","m":"단단하다, 굳다","s":"단단한(臤) 흙(土) → '굳다'."},
{"c":"除","m":"없애다, 덜다, 제외하다","s":"언덕(⻖)의 남은(余) 흙을 '덜어 낸다'."},
{"c":"壮","m":"장하다, 씩씩하다","s":"나무 조각(丬) 옆에 선비(士)가 '씩씩하게' 선다."},
{"c":"従","m":"따르다, 종사하다","s":"걸어가는(彳) 사람이 앞사람을 '따른다'."},
{"c":"精","m":"정밀하다, 정신, 정성","s":"쌀(米)을 푸르게(青) 빛날 만큼 '정성껏' 찧는다."},
{"c":"緯","m":"씨줄, 위도, 경위","s":"실(糸)을 가로로(韋) 엮은 '씨줄'."},
{"c":"掲","m":"내걸다, 게시하다","s":"손(扌)으로 높이 '내건다'."},
{"c":"拭","m":"닦다, 씻다","s":"손(扌)으로 정해진 방식(式)대로 '닦는다'."},
{"c":"肉","m":"고기, 살","s":"고기 결이 보이는 덩어리 → '고기'."},
{"c":"丹","m":"붉다, 정성(丹念)","s":"우물 속 붉은 돌 하나 → '붉다', 정성스러운 '丹念'."},
{"c":"曇","m":"흐리다","s":"해(日) 아래 구름(雲)이 끼어 '흐리다'."},
{"c":"競","m":"겨루다, 경쟁하다","s":"두 사람이 나란히 서서(立) '겨룬다'."},
{"c":"争","m":"다투다, 경쟁","s":"두 손이 막대를 서로 잡아당기며 '다툰다'."},
{"c":"凡","m":"평범하다, 무릇, 대략","s":"바람에 부푼 돛 하나 → 흔한 '평범함'."},
{"c":"今","m":"지금, 이제","s":"지붕(𠆢) 아래 하나(一)가 바로 '지금'."},
{"c":"宝","m":"보물, 보배","s":"집(宀) 안의 구슬(玉) → '보물'."},
{"c":"役","m":"역할, 소용","s":"걸어가(彳) 몽둥이(殳)를 들고 맡은 '역할'."},
{"c":"胆","m":"쓸개, 담력","s":"몸(月)에서 아침(旦)처럼 또렷한 '배짱'."},
{"c":"証","m":"증거, 증명하다","s":"말(言)을 바르게(正) 하는 '증거'."},
{"c":"仰","m":"우러러보다, 말씀하시다","s":"사람(亻)이 고개를 들어 '우러러본다'."},
{"c":"天","m":"하늘","s":"큰(大) 사람 머리 위의 선(一) → '하늘'."},
{"c":"償","m":"갚다, 보상하다","s":"사람(亻)이 상(賞)을 돌려주듯 '갚는다'."},
{"c":"厄","m":"재앙, 액운","s":"절벽(厂) 아래 웅크린 사람(㔾) → '재앙'."},
{"c":"介","m":"끼다, 소개하다, 중개","s":"사람(𠆢) 사이에 두 막대가 '끼어' 있다."},
{"c":"糸","m":"실","s":"실타래를 꼬아 늘어뜨린 '실'."},
{"c":"勘","m":"헤아리다, 직감","s":"심히(甚) 힘(力)을 들여 '헤아린다'."},
{"c":"弁","m":"말솜씨, 도시락(弁当), 판단","s":"두 손(廾)으로 갈라 말을 '분별한다'."},
{"c":"堵","m":"담, 안심(安堵)","s":"흙(土)담이 사람(者)을 지켜 주니 '안심'."},
{"c":"欲","m":"바라다, 욕심","s":"골짜기(谷)처럼 입을 크게 벌려(欠) '바란다'."},
{"c":"故","m":"까닭, 옛, 사고","s":"오래된(古) 일을 회초리(攵)로 따져 묻는 '까닭'."},
{"c":"戸","m":"문, 집","s":"한 짝짜리 '문'."},
{"c":"惑","m":"미혹하다, 당황하다","s":"혹시(或) 하는 마음(心)에 '갈팡질팡'한다."},
{"c":"端","m":"끝, 가장자리, 바르다","s":"서서(立) 끝(耑)까지 가 본 '가장자리'."},
{"c":"白","m":"희다, 하양","s":"햇빛이 빛나는 '흰' 모양."},
{"c":"詫","m":"사과하다(詫びる)","s":"말(言)로 몸을 맡기며(宅) '사과한다'."},
{"c":"謝","m":"감사하다, 사과하다","s":"말(言)로 활을 쏘듯(射) 마음을 전해 '감사한다'."},
{"c":"照","m":"비추다, 쬐다, 부끄러워하다","s":"해(日)와 불(灬)이 함께 '비춘다'."},
{"c":"寧","m":"편안하다, 정중하다(丁寧), 차라리","s":"집(宀) 안에 마음(心)과 그릇(皿)이 있어 '편안하다'."},
{"c":"裕","m":"넉넉하다, 여유","s":"옷(衤)이 골짜기(谷)처럼 '넉넉하다'."},
{"c":"妨","m":"방해하다","s":"여자(女)가 사방(方)을 막아 '방해한다'."},
{"c":"害","m":"해, 해치다","s":"집(宀) 안에 입(口)을 막는 것이 끼어 '해친다'."},
{"c":"審","m":"살피다, 심사하다","s":"집(宀) 안에서 차례(番)로 '살핀다'."},
{"c":"怪","m":"이상하다, 수상하다","s":"마음(忄)이 손(又)으로 흙(土)을 만지듯 '수상하다'."},
{"c":"例","m":"예, 보기","s":"사람(亻)이 줄(列)을 서서 보이는 '본보기'."},
{"c":"珍","m":"드물다, 진귀하다","s":"구슬(王)에 머리털(彡) 무늬 → '진귀하다'."},
{"c":"絡","m":"얽히다, 연락","s":"실(糸)이 각각(各) '얽혀' 이어진다."},
{"c":"吟","m":"읊다, 음미하다","s":"입(口)으로 지금(今) 시를 '읊는다'."},
{"c":"討","m":"치다, 검토하다","s":"말(言)을 손(寸)으로 다듬어 '따진다'."},
{"c":"視","m":"보다, 시력","s":"제단(礻) 앞에서 똑바로 '본다(見)'."},
{"c":"架","m":"걸다, 시렁, 가공","s":"더한(加) 나무(木)로 만든 '시렁'."},
{"c":"愚","m":"어리석다","s":"원숭이(禺) 같은 마음(心) → '어리석다'."},
{"c":"痴","m":"어리석다, 치~","s":"병(疒)에 걸린 듯 아는(知) 것을 잊어 '어리석다'."},
{"c":"賑","m":"붐비다, 활기차다(賑やか)","s":"돈(貝)이 떨치며(辰) 오가니 '북적인다'."},
{"c":"質","m":"질, 바탕, 묻다","s":"도끼(斤) 두 자루와 돈(貝)을 맡기는 '바탕'."},
{"c":"布","m":"천, 베, 펴다","s":"손(𠂇)에 천(巾)을 든 '베'."},
{"c":"赴","m":"가다, 향하다, 부임","s":"달려가(走) 점(卜)친 곳으로 '향한다'."},
{"c":"携","m":"휴대하다, 지니다, 관여하다","s":"손(扌)에 새(隹)를 '지니고' 간다."},
{"c":"総","m":"모두, 거느리다, 총","s":"실(糸)을 모두 모아 '거느린다'."},
{"c":"免","m":"면하다, 허가(免許)","s":"투구를 벗고 위험을 '면한다'."},
{"c":"処","m":"곳, 처리하다","s":"걸어온(夂) 사람이 책상(几)에 앉는 '곳' → '처리'."},
{"c":"煩","s":"불(火)이 머리(頁)까지 올라 '번거롭다'."},
{"c":"拍","m":"치다, 박자","s":"손(扌)으로 하얗게(白) 소리 나게 '친다'."},
{"c":"優","m":"뛰어나다, 다정하다, 배우","s":"사람(亻)이 근심(憂)을 알아주니 '다정하다'."},
{"c":"剥","m":"벗기다, 벗겨지다","s":"칼(刂)로 껍질을 '벗긴다'."},
{"c":"旧","m":"옛, 오래된","s":"해(日)가 막대 옆에 오래 걸린 '옛날'."},
{"c":"更","m":"고치다, 다시, 더욱","s":"해(日) 아래 다시 '고친다'."},
{"c":"辞","m":"말, 그만두다, 사전","s":"혀(舌)의 매운(辛) 말 → '말', 그리고 '그만두다'."},
{"c":"統","m":"거느리다, 통합하다","s":"실(糸)을 가득 채워(充) 하나로 '거느린다'."},
{"c":"閑","m":"한가하다, 조용하다","s":"문(門) 안에 나무(木)가 서 있을 뿐 '한가하다'."},
{"c":"昇","m":"오르다, 승진","s":"해(日)가 되(升)만큼씩 '떠오른다'."},
{"c":"提","m":"끌다, 들다, 제출하다","s":"손(扌)으로 옳다(是) 하며 '내놓는다'."},
{"c":"真","m":"참, 진짜, 한가운데","s":"열(十) 개의 눈(目)으로 봐도 '참'이다."},
{"c":"属","m":"속하다, 무리","s":"엉덩이(尸) 아래 벌레가 붙듯 '속한다'."},
{"c":"様","m":"모양, ~님","s":"나무(木) 아래 양(羊)과 물(水)이 이룬 '모양' → '~님'."},
{"c":"脚","m":"다리","s":"몸(月)을 물러나게(却) 해 주는 '다리'."},
{"c":"柄","m":"자루, 무늬, 성품","s":"나무(木) 손잡이를 남쪽(丙)으로 둔 '자루'."},
{"c":"是","m":"옳다, 이(是非)","s":"해(日) 아래 바르게(正) 서니 '옳다'."},
{"c":"培","m":"북돋우다, 기르다(培う)","s":"흙(土)을 갈라(咅) 덮어 '북돋운다'."},
{"c":"憂","s":"머리(頁)와 마음(心)이 무거워 천천히 걷는다(夂) → '근심'."},
{"c":"惧","s":"마음(忄)이 갖춰진(具) 위험을 보고 '두려워한다'."},
{"c":"斡","m":"돌리다, 알선(斡旋)","s":"말(斗) 국자를 빙 '돌린다' → '알선'."},
{"c":"旋","m":"돌다, 회전하다","s":"깃발(方) 아래 발(疋)이 빙글 '돈다'."},
{"c":"拾","m":"줍다","s":"손(扌)으로 모아(合) '줍는다'."},
{"c":"易","m":"쉽다, 바꾸다(貿易)","s":"해(日) 아래 도마뱀이 색을 '바꾼다' → '쉽다'."},
{"c":"軟","m":"부드럽다, 연하다","s":"수레(車)가 하품(欠)하듯 늘어져 '부드럽다'."}
]
