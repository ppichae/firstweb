[
{"c":"計","m":"세다, 재다, 계획하다","s":"말(言)로 열(十)까지 세어 본다 → '세다, 재다'."},
{"c":"算","m":"계산하다, 셈","s":"대나무(竹) 막대를 눈(目)으로 보며 두 손으로 늘어놓고 셈한다."},
{"c":"浅","m":"얕다, 옅다","s":"물(氵)이 창(戈) 끝만큼밖에 안 찬다 → '얕다'."},
{"c":"広","m":"넓다, 넓히다","s":"지붕(广) 아래 작은 것(厶) 하나만 있으니 방이 '넓다'."},
{"c":"告","m":"알리다","s":"소(牛 모양)가 입(口) 앞에서 울어 소식을 '알린다'."},
{"c":"種","m":"씨, 종류","s":"벼(禾)에서 무거운(重) 알맹이를 골라 '씨'로 남긴다."},
{"c":"類","m":"무리, 종류, 비슷하다","s":"쌀(米)과 개(犬 모양)와 머리(頁)를 종류별로 나눈다 → '무리'."},
{"c":"勝","m":"이기다, 낫다","s":"몸(月)에 힘(力)을 끝까지 모은 사람이 '이긴다'."},
{"c":"悲","m":"슬프다, 슬퍼하다","s":"마음(心)이 아니다(非)라고 외칠 만큼 '슬프다'."},
{"c":"整","m":"가지런히 하다, 정리하다","s":"묶고(束) 두드려(攵) 바르게(正) 맞추니 '가지런하다'."},
{"c":"理","m":"이치, 다스리다","s":"옥(王)의 결을 마을(里) 사람들이 따지니 '이치'가 보인다."},
{"c":"平","m":"평평하다, 평범하다","s":"저울대(干) 양쪽에 점이 같으니 기울지 않고 '평평하다'."},
{"c":"均","m":"고르다, 균등하다","s":"흙(土)을 고루(匀) 펴서 '고르게' 한다."},
{"c":"油","m":"기름","s":"물(氵)처럼 흐르는데 말미암아(由) 불이 붙는 것 → '기름'."},
{"c":"流","s":"물(氵)이 아이가 거꾸로 미끄러지듯 쭉 내려간다 → '흐르다'."},
{"c":"区","m":"구역, 나누다","s":"상자(匚) 안을 X자로 나누어 '구역'을 만든다."},
{"c":"別","s":"칼(刂)로 뼈와 살을 갈라 '나누다, 헤어지다'."},
{"c":"包","m":"싸다, 감싸다","s":"팔(勹)로 아기(巳 모양)를 폭 '감싼다'."},
{"c":"命","m":"목숨, 명령","s":"지붕 아래(𠆢) 입(口)으로 무릎 꿇은 사람(卩)에게 내리는 '명령', 그리고 '목숨'."},
{"c":"令","m":"명령, 하여금","s":"지붕(𠆢) 아래 무릎 꿇은 사람(卩)이 '명령'을 받는다."},
{"c":"右","m":"오른쪽","s":"밥 먹는 손으로 입(口)을 가린다 → 숟가락 드는 '오른쪽'."},
{"c":"折","m":"접다, 꺾다, 부러지다","s":"손(扌)으로 도끼(斤)처럼 힘을 주어 '꺾는다'."},
{"c":"空","m":"하늘, 비다","s":"구멍(穴) 너머로 만든(工) 것 없이 텅 '비어' 있는 '하늘'."},
{"c":"席","m":"자리, 좌석","s":"지붕(广) 아래 천(巾)을 깔아 앉는 '자리'."},
{"c":"調","m":"조사하다, 상태, 가락","s":"말(言)로 두루(周) 물어보며 '조사한다', 고르게 맞춘다."},
{"c":"子","m":"아이, 자식","s":"두 팔을 벌린 '아이'가 한 다리로 서 있는 모습으로 기억해요."},
{"c":"暗","m":"어둡다, 외우다","s":"해(日)는 지고 소리(音)만 들린다 → '어둡다'."},
{"c":"記","m":"기록하다, 적다","s":"말(言)을 몸(己)에 새기듯 '적어 둔다'."},
{"c":"尊","m":"높이다, 귀하다","s":"술병(酋)을 손(寸)으로 받쳐 드리니 '높이 받든다'."},
{"c":"敬","m":"공경하다","s":"풀(艹) 아래 몸을 웅크리고(句) 회초리(攵)를 무서워하듯 '공경한다'."},
{"c":"抑","m":"누르다, 억누르다","s":"손(扌)으로 무릎 꿇은 사람(卩)을 내리 '누른다'."},
{"c":"人","m":"사람","s":"두 다리로 땅을 딛고 선 '사람'의 옆모습으로 기억해요."},
{"c":"工","m":"만들다, 기술, 공사","s":"위아래 판을 기둥 하나로 잇는 '공사' 도구 모양이에요."},
{"c":"楽","m":"즐겁다, 편하다, 음악","s":"나무(木) 위에 하얀(白) 것이 흔들리며 소리가 나니 '즐겁다'."},
{"c":"簡","m":"간단하다, 편지","s":"대나무(竹) 문(門) 사이로 해(日)가 비치듯 '간단'하다."},
{"c":"単","m":"하나, 단순하다","s":"밭(田) 위에 점 셋(⺌)이 하나의 줄(十)에 꿰인 '홑' 모양."},
{"c":"大","s":"두 팔과 두 다리를 쫙 벌린 사람 → '크다'."},
{"c":"多","m":"많다","s":"저녁(夕)이 두 번 겹친다 → 날이 쌓여 '많다'."},
{"c":"交","m":"사귀다, 섞이다, 엇갈리다","s":"뚜껑(亠) 아래 아버지(父)처럼 다리를 엇갈려 '사귄다'."},
{"c":"換","m":"바꾸다","s":"손(扌)으로 크게(大) 내놓고 '바꾼다'."},
{"c":"取","s":"귀(耳)를 손(又)으로 잡는다 → '취하다, 잡다'."},
{"c":"替","m":"바꾸다, 대신하다","s":"두 사람(夫夫)이 해(日) 아래에서 자리를 '바꾼다'."},
{"c":"看","m":"보다, 지켜보다","s":"손(手)을 눈(目) 위에 대고 멀리 '본다'."},
{"c":"板","m":"판자, 판","s":"나무(木)를 뒤집어(反) 평평하게 켠 '판자'."},
{"c":"募","m":"모으다, 모집하다","s":"풀(艹) 우거진 해(日) 질 녘 큰(大) 힘(力)으로 사람을 '모은다'."},
{"c":"集","s":"새(隹)들이 나무(木) 위에 '모인다'."},
{"c":"費","m":"쓰다, 비용","s":"활(弓)처럼 휘게 돈(貝)을 '쓴다' → '비용'."},
{"c":"内","s":"테두리(冂) 안으로 사람(人)이 들어간다 → '안'."},
{"c":"側","m":"곁, 쪽","s":"사람(亻)이 법칙(則) 옆에 선다 → '곁, 쪽'."},
{"c":"涙","m":"눈물","s":"문(戸) 앞에서 물(氵)방울이 크게(大) 떨어진다 → '눈물'."},
{"c":"地","s":"흙(土)이 넓게 이어진다(也) → '땅'."},
{"c":"面","m":"얼굴, 면, 겉","s":"네모난 틀 안에 눈(目)이 있는 '얼굴'."},
{"c":"移","m":"옮기다, 옮다","s":"벼(禾)를 많이(多) 다른 곳으로 '옮긴다'."},
{"c":"呼","m":"부르다","s":"입(口)에서 소리가 퍼져 나가며 '부른다'."},
{"c":"吸","m":"빨아들이다, 마시다","s":"입(口)이 공기에 닿자마자(及) 쭉 '들이마신다'."},
{"c":"身","m":"몸, 자신","s":"배가 불룩한 사람의 옆모습 → '몸'."},
{"c":"長","m":"길다, 우두머리","s":"긴 머리카락을 늘어뜨린 어른 → '길다, 우두머리'."},
{"c":"困","m":"곤란하다, 난처하다","s":"나무(木)가 상자(囗) 안에 갇혀 자라지 못해 '곤란하다'."},
{"c":"育","m":"기르다, 자라다","s":"거꾸로 태어난 아기(𠫓)를 몸(月)으로 품어 '기른다'."},
{"c":"煙","m":"연기, 담배","s":"불(火)을 피우니 서쪽(西) 흙(土) 위로 '연기'가 오른다."},
{"c":"森","m":"숲","s":"나무(木)가 셋이나 모였다 → 빽빽한 '숲'."},
{"c":"林","m":"수풀","s":"나무(木) 두 그루가 나란히 → '수풀'."},
{"c":"浴","m":"목욕하다, (빛을) 쬐다","s":"물(氵)이 골짜기(谷)처럼 쏟아지니 '목욕한다'."},
{"c":"送","m":"보내다","s":"길(辶) 위로 짐을 들고 웃으며(关 모양) '보낸다'."},
{"c":"信","m":"믿다, 소식","s":"사람(亻)의 말(言)이니 '믿는다'."},
{"c":"中","m":"가운데, 안","s":"상자(口) 한가운데를 막대가 꿰뚫는다 → '가운데'."},
{"c":"古","m":"옛, 오래되다","s":"열(十) 사람의 입(口)을 거쳐 전해진 '옛'이야기."},
{"c":"悔","m":"후회하다, 분하다","s":"마음(忄)속에서 매일(毎) 되새기며 '뉘우친다'."},
{"c":"距","m":"떨어지다, 거리","s":"발(⻊)을 크게(巨) 벌려 '거리'를 잰다."},
{"c":"離","m":"떨어지다, 떠나다","s":"새(隹)가 둥지를 '떠나' 멀리 '떨어진다'."},
{"c":"吹","m":"불다","s":"입(口)을 크게 벌리고 하품(欠)하듯 바람을 '분다'."},
{"c":"文","m":"글, 문장","s":"가슴에 무늬를 새긴 사람 → 무늬처럼 쓴 '글'."},
{"c":"句","m":"구절, 글귀","s":"입(口)에서 나온 말을 팔(勹)로 묶은 한 '구절'."},
{"c":"思","m":"생각하다","s":"밭(田)처럼 넓은 머리와 마음(心)으로 '생각한다'."},
{"c":"坂","m":"언덕, 비탈","s":"흙(土)이 뒤집혀(反) 기울어진 '비탈'."},
{"c":"道","m":"길, 도리","s":"머리(首)를 앞세워 걸어가는(辶) '길'."},
{"c":"列","m":"줄, 늘어서다","s":"칼(刂)로 잘라 차례로 늘어놓은 '줄'."},
{"c":"録","m":"기록하다","s":"쇠(金)에 물(水)처럼 새겨 남긴 '기록'."},
{"c":"静","m":"조용하다, 고요하다","s":"푸른(青) 숲에서 다툼(争)이 멎으니 '고요하다'."},
{"c":"早","m":"이르다, 빠르다","s":"해(日)가 막 십자(十) 기둥 위로 떠오른 '이른' 아침."},
{"c":"退","m":"물러나다, 물리치다","s":"길(辶)에서 멈추고(艮) 뒤로 '물러난다'."},
{"c":"帰","m":"돌아가다, 돌아오다","s":"빗자루(帚)를 든 사람이 집으로 '돌아간다'."},
{"c":"経","m":"지나다, 경과하다, 경영하다","s":"실(糸)을 세로로 길게 걸어 날짜가 '지나간다'."},
{"c":"過","s":"길(辶)을 입 벌린 골목(咼)으로 그냥 '지나간다'."},
{"c":"減","m":"줄다, 줄이다","s":"물(氵)을 창(戈)으로 다 퍼내니(咸) '준다'."},
{"c":"重","m":"무겁다, 겹치다, 중요하다","s":"마을(里) 위에 짐을 또 얹으니 '무겁다', '겹친다'."},
{"c":"皮","m":"가죽, 껍질","s":"손(又)으로 짐승의 '가죽'을 벗기는 모습으로 기억해요."},
{"c":"西","m":"서쪽","s":"해가 지는 쪽, 둥지에 앉은 새를 덮은 모양 → '서쪽'."},
{"c":"洋","m":"큰 바다, 서양","s":"물(氵)이 양(羊) 떼처럼 넓게 펼쳐진 '큰 바다'."},
{"c":"腹","m":"배","s":"몸(月)에서 다시(复) 불룩해지는 곳 → '배'."},
{"c":"痛","m":"아프다","s":"병(疒) 안에서 쿡쿡 찌르듯(甬) '아프다'."},
{"c":"点","m":"점, 점수, 켜다","s":"점(⺣)이 네 개 찍힌 자리(占) → '점, 점수'."},
{"c":"帯","m":"띠, 지니다","s":"천(巾)을 허리에 두른 '띠'."},
{"c":"郵","m":"우편","s":"마을(⻏)과 마을을 잇는 '우편'."},
{"c":"便","m":"편하다, 편지, 편(교통편)","s":"사람(亻)이 고쳐(更) 쓰니 '편하다'."},
{"c":"辺","m":"주변, 근처","s":"길(辶)을 칼(刀)로 그은 듯한 가장자리 → '주변'."},
{"c":"図","m":"그림, 지도, 꾀하다","s":"테두리(囗) 안에 그려 넣은 '그림, 지도'."},
{"c":"歩","m":"걷다","s":"멈춘 발(止) 아래 작은(少) 걸음 → '걷다'."},
{"c":"打","m":"치다, 때리다","s":"손(扌)으로 못(丁)을 '친다'."},
{"c":"性","m":"성질, 성별","s":"마음(忄)에 날 때(生)부터 있는 것 → '성질'."},
{"c":"格","m":"격, 자격, 등급","s":"나무(木)마다 각각(各) 정해진 '격'이 있다."},
{"c":"時","m":"때, 시간","s":"해(日)가 절(寺)의 종소리처럼 정확히 알려 주는 '때'."},
{"c":"差","m":"차이, 내밀다","s":"양(羊)과 공구(工)를 나란히 놓아 '차이'를 본다."},
{"c":"決","s":"물(氵)이 둑을 터뜨려(夬) 갈 길을 '정한다'."},
{"c":"心","s":"심장 모양에 점 셋 → '마음'."},
{"c":"冗","m":"쓸데없다, 군더더기","s":"덮개(冖) 아래 책상(几)만 덩그러니 → '쓸데없이 남는다'."},
{"c":"談","m":"이야기, 말씀","s":"불(炎) 옆에 둘러앉아 말(言)을 나누는 '이야기'."},
{"c":"与","m":"주다, 더불다","s":"손을 내밀어 하나(一)를 '준다'."},
{"c":"案","m":"안, 생각, 책상","s":"편안한(安) 나무(木) 책상에서 짜낸 '안, 생각'."},
{"c":"外","m":"바깥, 밖, 벗어나다","s":"저녁(夕)에 점(卜)을 치러 '밖'에 나간다."},
{"c":"努","m":"힘쓰다, 노력하다","s":"종(奴)처럼 힘(力)을 다해 '힘쓴다'."},
{"c":"力","s":"팔에 불끈 힘줄이 선 모양 → '힘'."},
{"c":"正","m":"바르다, 정확하다","s":"한(一) 줄 앞에 발(止)을 딱 멈추니 '바르다'."},
{"c":"常","m":"늘, 항상, 보통","s":"높은(尚) 곳에 늘 걸어 두는 천(巾) → '항상'."},
{"c":"付","m":"붙다, 붙이다, 주다","s":"사람(亻)에게 손(寸)을 '붙여' 건네준다."},
{"c":"清","m":"맑다, 깨끗하다","s":"물(氵)이 푸르게(青) 비치니 '맑다'."},
{"c":"潔","s":"물(氵)로 실(糸)을 칼(刀)로 다듬어 씻으니 '깨끗하다'."},
{"c":"台","m":"대, 받침, 대수","s":"작은 것(厶)을 입(口) 모양 받침 위에 올린 '대'."},
{"c":"所","m":"곳, 장소","s":"문(戸) 옆에 도끼(斤)를 두는 '곳'."},
{"c":"指","m":"손가락, 가리키다","s":"손(扌)으로 맛있는(旨) 것을 '가리킨다'."},
{"c":"導","m":"이끌다, 인도하다","s":"길(道)에서 손(寸)을 잡고 '이끈다'."},
{"c":"教","m":"가르치다","s":"아이(子)를 회초리(攵)를 들고 '가르친다'."},
{"c":"握","m":"쥐다, 잡다","s":"손(扌)으로 집(屋) 열쇠를 꽉 '쥔다'."},
{"c":"修","m":"닦다, 고치다, 익히다","s":"사람(亻)이 붓(彡)을 들고 몸과 마음을 '닦는다'."},
{"c":"目","m":"눈, 항목, 순서","s":"세로로 세운 '눈' 모양으로 기억해요."},
{"c":"懐","m":"품, 그리워하다","s":"마음(忄)에 옷(衣)깃처럼 품어 '그리워한다'."},
{"c":"変","s":"뚜껑(亠) 아래 발(夂)이 엉키니 모습이 '변한다'."},
{"c":"化","m":"되다, 변하다, ~화","s":"서 있던 사람(亻)이 뒤집힌 사람(匕)이 된다 → '변화'."},
{"c":"割","m":"나누다, 깨다, 비율","s":"집(宀) 안의 물건을 칼(刂)로 '가른다'."},
{"c":"基","m":"터, 기초","s":"그(其) 아래 흙(土)을 다진 '터'."},
{"c":"本","m":"책, 근본, 진짜","s":"나무(木) 아래 뿌리에 선을 그었다 → '근본', 그리고 '책'."},
{"c":"横","m":"옆, 가로","s":"나무(木)를 누렇게(黄) 옆으로 눕힌 '가로'."},
{"c":"最","m":"가장, 제일","s":"해(日) 아래 귀(耳)를 손(又)으로 잡아 '가장' 먼저 차지한다."},
{"c":"初","m":"처음","s":"옷(衤)을 만들 때 칼(刀)로 '처음' 자른다."},
{"c":"返","m":"돌려주다, 돌아오다","s":"길(辶)을 뒤집어(反) '돌아온다'."},
{"c":"丁","m":"정(두부 등을 세는 말), 정중함","s":"못 하나를 박은 모양 → 반듯한 '정'."},
{"c":"適","m":"알맞다, 적당하다","s":"길(辶)을 가다 딱 맞는 곳에 이른다 → '알맞다'."},
{"c":"当","s":"손(ヨ) 위에 빛(⺌)이 딱 '맞는다' → '맞다, 마땅하다'."},
{"c":"家","m":"집, 가족, ~가","s":"지붕(宀) 아래 돼지(豕)를 기르는 '집'."},
{"c":"具","m":"도구, 갖추다","s":"눈(目) 아래 두 손으로 받쳐 든 '도구'."},
{"c":"解","m":"풀다, 이해하다","s":"칼(刀)로 소(牛)의 뿔(角)을 갈라 '푼다'."},
{"c":"腰","m":"허리","s":"몸(月)에서 중요한(要) 곳 → '허리'."},
{"c":"翌","m":"다음(날·해)","s":"깃(羽)을 세우고(立) 날아가면 '다음' 날이 된다."},
{"c":"週","m":"주, 일주일","s":"길(辶)을 두루(周) 한 바퀴 도는 '일주일'."},
{"c":"低","m":"낮다","s":"사람(亻)이 밑바닥(氐)까지 몸을 '낮춘다'."},
{"c":"方","s":"쟁기 손잡이가 한쪽으로 뻗은 모양 → '방향, 방법'."},
{"c":"向","m":"향하다, 방향","s":"집의 창(口)이 한쪽을 '향해' 있다."},
{"c":"規","m":"규칙, 법","s":"사내(夫)가 보고(見) 따르는 '규칙'."},
{"c":"則","m":"법칙, 규칙","s":"돈(貝)을 칼(刂)로 똑같이 나누는 '법칙'."},
{"c":"影","m":"그림자, 영향","s":"햇빛(景)에 털(彡) 같은 무늬가 드리운 '그림자'."},
{"c":"響","m":"울리다, 영향을 주다","s":"마을(郷)에 소리(音)가 퍼져 '울린다'."},
{"c":"我","m":"나, 자기","s":"손(手)에 창(戈)을 든 '나' 자신."},
{"c":"慢","m":"게으르다, 거만하다","s":"마음(忄)이 길게 늘어져(曼) '게으르다'."},
{"c":"極","m":"극, 다하다, 아주","s":"나무(木) 기둥을 끝까지 다해 세운 '극'."},
{"c":"由","m":"이유, 말미암다","s":"밭(田)에서 싹이 위로 뚫고 나온 '까닭'."},
{"c":"仲","m":"사이, 관계","s":"사람(亻) 가운데(中)에 있는 '사이'."},
{"c":"一","m":"하나, 첫째","s":"선 하나 → '하나'."},
{"c":"度","m":"~번, 정도, 도(온도)","s":"집(广)에서 손(又)으로 재는 '정도'와 '횟수'."},
{"c":"諦","m":"단념하다, 체념하다","s":"말(言)로 임금(帝)의 결정을 듣고 '단념한다'."},
{"c":"売","m":"팔다","s":"선비(士)가 덮개(冖) 아래 물건을 내놓고 '판다'."},
{"c":"切","m":"자르다, 끊다, 간절하다","s":"칼(刀)로 일곱(七) 번 '자른다'."},
{"c":"全","s":"지붕(𠆢) 아래 옥(王)이 하나도 빠짐없이 → '온전하다, 모두'."},
{"c":"部","m":"부분, 부서","s":"서서(立) 말하는(口) 마을(⻏) 사람들로 나뉜 '부서'."},
{"c":"曲","m":"굽다, 곡(노래)","s":"상자(曰)에 꽂힌 두 막대가 휘어 '굽었다', 그리고 노래 '곡'."},
{"c":"屈","m":"굽히다, 굴복하다","s":"엉덩이(尸) 아래로 나온(出) 몸을 '굽힌다'."}
]
