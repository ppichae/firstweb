[
{"c":"緩","m":"느슨하다, 완만하다, 느긋하다","s":"실(糸)을 손으로 당겼다 놓으니 '느슨해진다'."},
{"c":"識","m":"알다, 식별하다","s":"말(言)과 소리(音)를 창(戈)으로 새기듯 기억해 '안다'."},
{"c":"完","m":"완전하다, 끝내다","s":"지붕(宀) 아래 으뜸(元)이 다 갖춰져 '완전하다'."},
{"c":"成","m":"이루다, 되다","s":"창(戈)을 들고 끝까지 싸워 뜻을 '이룬다'."},
{"c":"慌","m":"허둥대다, 당황하다","s":"마음(忄)이 거친(荒) 들판처럼 어수선해 '허둥댄다'."},
{"c":"実","m":"열매, 진실, 실제","s":"지붕(宀) 아래 크게(大) 영근 '열매'."},
{"c":"物","s":"소(牛)처럼 손에 쥘 수 있는 것 → '물건'."},
{"c":"寒","m":"춥다","s":"집(宀) 안에서도 얼음(冫)이 어니 '춥다'."},
{"c":"狭","m":"좁다, 좁히다","s":"개(犭)가 두 사람 사이에 끼어(夾) '좁다'."},
{"c":"込","s":"길(辶)로 들어간다(入) → '붐비다, 담다'. 일본에서 만든 한자예요."},
{"c":"間","m":"사이, 동안, 방","s":"문(門) 틈 사이로 해(日)가 보인다 → '사이'."},
{"c":"行","s":"네거리를 오가는 모양 → '가다, 행하다'."},
{"c":"運","m":"나르다, 운, 운전","s":"군대(軍)가 길(辶)로 짐을 '나른다', 그리고 '운'."},
{"c":"転","m":"구르다, 넘어지다, 바꾸다","s":"수레(車)바퀴가 데굴데굴 '구른다'."},
{"c":"手","s":"다섯 손가락을 편 '손'."},
{"c":"働","m":"일하다","s":"사람(亻)이 움직여(動) '일한다'. 일본에서 만든 한자예요."},
{"c":"乗","m":"타다, 태우다","s":"나무(木) 위에 사람이 올라탄 모양 → '타다'."},
{"c":"遅","m":"늦다, 느리다","s":"길(辶)에서 양(羊)을 끌고 가니 '느리다'."},
{"c":"刻","m":"새기다, 시각","s":"칼(刂)로 돼지(亥) 뼈에 '새긴다', 시간을 새기는 '시각'."},
{"c":"聞","m":"듣다, 묻다","s":"문(門)에 귀(耳)를 대고 '듣는다'."},
{"c":"際","m":"때, 가장자리, 사이","s":"언덕(⻖)과 제단(祭)이 만나는 '가장자리'."},
{"c":"着","m":"입다, 도착하다, 붙다","s":"양(羊)털 옷을 눈(目)앞에서 '입는다', 그리고 '도착하다'."},
{"c":"町","m":"마을, 동네","s":"밭(田) 사이로 길(丁)이 난 '마을'."},
{"c":"続","m":"잇다, 계속되다","s":"실(糸)을 팔(売) 때까지 '계속' 잇는다."},
{"c":"復","m":"되돌아오다, 다시, 회복","s":"걸어간(彳) 길을 다시(复) '되돌아온다'."},
{"c":"習","m":"익히다, 배우다","s":"새가 흰(白) 깃(羽)을 몇 번이고 퍼덕이며 나는 법을 '익힌다'."},
{"c":"小","m":"작다","s":"가운데 선 양옆에 점 두 개 → 작게 나눈 '작다'."},
{"c":"型","m":"틀, 모형, 형","s":"흙(土)으로 모양(刑) 틀을 만든다 → '틀, 형'."},
{"c":"疑","m":"의심하다","s":"화살(矢)을 들고 갈림길에서 머뭇거리며 '의심한다'."},
{"c":"細","m":"가늘다, 자세하다","s":"실(糸)로 밭(田)을 가늘게 나눈다 → '가늘다, 자세하다'."},
{"c":"院","m":"원(병원·학원 등), 기관","s":"언덕(⻖) 위에 완전한(完) 건물 → '원'."},
{"c":"夫","m":"남편, 사내","s":"큰(大) 사람 머리에 비녀(一)를 꽂은 어른 → '남편'."},
{"c":"婦","m":"아내, 부인","s":"여자(女)가 빗자루(帚)를 든 모습 → '부인'."},
{"c":"留","m":"머무르다, 남기다","s":"밭(田)에 칼(刀)로 표시해 두고 '머문다'."},
{"c":"守","m":"지키다","s":"집(宀)을 손(寸)으로 '지킨다'."},
{"c":"高","m":"높다, 비싸다","s":"높은 누각이 층층이 솟은 모양 → '높다'."},
{"c":"価","m":"값, 가치","s":"사람(亻)이 서쪽(西) 시장에서 매기는 '값'."},
{"c":"汚","m":"더럽히다, 더럽다","s":"물(氵)이 구불구불(亏) 고여 '더러워진다'."},
{"c":"選","m":"고르다, 뽑다","s":"길(辶)에 줄 선 사람들 중에서 '고른다'."},
{"c":"月","m":"달, 월","s":"초승달 모양 → '달'."},
{"c":"末","m":"끝, 말","s":"나무(木) 위쪽 긴 선 → 가지 '끝'."},
{"c":"裏","m":"뒤, 안쪽","s":"옷(衣) 속에 마을(里)이 숨은 '안쪽, 뒷면'."},
{"c":"産","m":"낳다, 생산하다","s":"언덕(厂) 아래에서 새 생명이 나온다(生) → '낳다'."},
{"c":"業","s":"악기 걸이에 장식이 주렁주렁 → 맡아 하는 '일, 업'."},
{"c":"朝","m":"아침","s":"풀 사이로 해(日)가 뜨고 달(月)이 남아 있는 '아침'."},
{"c":"刊","m":"펴내다, 간행","s":"칼(刂)로 나무판(干)을 깎아 책을 '펴낸다'."},
{"c":"断","m":"끊다, 거절하다, 판단하다","s":"쌀(米) 자루를 도끼(斤)로 '끊는다'."},
{"c":"短","m":"짧다","s":"화살(矢)과 콩(豆)은 둘 다 '짧다'."},
{"c":"気","s":"솥에서 김(气)이 피어오른다 → '기운'."},
{"c":"配","m":"나누다, 배달하다, 걱정","s":"술병(酉) 옆에 사람이 무릎 꿇고 술을 '나눈다'."},
{"c":"焼","m":"굽다, 태우다","s":"불(火) 위에 높이(尭) 올려 '굽는다'."},
{"c":"必","m":"반드시","s":"마음(心)에 창을 꽂듯 '반드시' 지킨다."},
{"c":"制","m":"제도, 억제하다","s":"칼(刂)로 가지를 쳐 모양을 '정한다'."},
{"c":"服","m":"옷, 따르다","s":"몸(月)에 맞게 '옷'을 입고 따른다."},
{"c":"薬","m":"약","s":"풀(艹)로 몸을 즐겁게(楽) 하는 것 → '약'."},
{"c":"局","m":"국(우체국 등), 판국","s":"몸(尸)을 굽혀 일하는 작은 방 → '국'."},
{"c":"降","m":"내리다, 내려가다","s":"언덕(⻖)에서 발(夂)을 내디뎌 '내려간다'."},
{"c":"宅","m":"집, 댁","s":"지붕(宀) 아래 몸을 맡기는(乇) '집'."},
{"c":"法","m":"법, 방법","s":"물(氵)이 흘러가는(去) 길처럼 정해진 '법'."},
{"c":"律","m":"법, 규율, 가락","s":"걸어가는(彳) 사람이 붓(聿)으로 적은 '규율'."},
{"c":"会","m":"만나다, 모임","s":"지붕(𠆢) 아래 사람들이 '모인다'."},
{"c":"倒","m":"넘어지다, 쓰러뜨리다","s":"사람(亻)이 이르러(到) 그만 '넘어진다'."},
{"c":"可","m":"옳다, 가능하다","s":"입(口)으로 '좋아' 하고 허락한다 → '가능'."},
{"c":"能","m":"능력, 할 수 있다","s":"곰이 몸(月)과 발톱(匕)으로 뭐든 '할 수 있다'."},
{"c":"作","m":"만들다, 작품","s":"사람(亻)이 잠깐(乍) 사이에 '만든다'."},
{"c":"期","m":"기간, 기약하다","s":"그(其) 달(月)까지로 정한 '기간'."},
{"c":"限","m":"한계, 한정하다","s":"언덕(⻖)에 막혀 멈추는(艮) '한계'."},
{"c":"恋","m":"사랑, 그리워하다","s":"마음(心) 위에 실이 엉킨 듯 → '사랑'."},
{"c":"想","m":"생각하다, 상상","s":"나무(木)를 눈(目)으로 보며 마음(心)으로 '생각한다'."},
{"c":"像","m":"모습, 형상, 상","s":"사람(亻)이 코끼리(象)를 닮게 만든 '상'."},
{"c":"振","m":"흔들다, 휘두르다","s":"손(扌)으로 크게 '흔든다'."},
{"c":"感","m":"느끼다, 감정","s":"마음(心) 위에 다(咸) 모여 '느낀다'."},
{"c":"覚","m":"깨닫다, 외우다, 깨다","s":"덮개(冖)를 걷고 보니(見) '깨닫는다'."},
{"c":"効","m":"효과, 듣다(효과가 있다)","s":"사귐(交)에 힘(力)을 쓰니 '효과'가 난다."},
{"c":"果","m":"열매, 결과, 다하다","s":"나무(木) 위에 열린 밭(田) 모양 '열매' → '결과'."},
{"c":"互","m":"서로","s":"두 손이 엇갈려 맞잡은 모양 → '서로'."},
{"c":"番","m":"차례, 번, 지키다","s":"밭(田) 위에 씨를 차례로(釆) 뿌린다 → '차례, 번'."},
{"c":"得","m":"얻다, 이득","s":"길(彳)을 가다 해(日) 아래에서 손(寸)으로 '얻는다'."},
{"c":"欠","m":"빠지다, 모자라다, 결석","s":"사람이 입을 벌리고 하품하니 기운이 '빠진다'."},
{"c":"怒","s":"종(奴)처럼 부림당한 마음(心)이 '화가 난다'."},
{"c":"鳴","m":"울다, 울리다","s":"새(鳥)가 입(口)을 벌려 '운다'."},
{"c":"避","m":"피하다","s":"길(辶)에서 매운(辛) 일을 만나면 '피한다'."},
{"c":"難","m":"어렵다, 재난","s":"새(隹)가 진흙(堇) 속에 빠져 날기 '어렵다'."},
{"c":"逃","m":"달아나다, 놓치다","s":"길(辶)을 조짐(兆)만 보고 '달아난다'."},
{"c":"黙","m":"잠잠하다, 말없다","s":"검은(黒) 개(犬)가 짖지 않고 '말없이' 있다."},
{"c":"達","m":"이르다, 통달하다, ~들","s":"길(辶)을 양(羊)처럼 꾸준히 가서 '이른다'."},
{"c":"届","m":"닿다, 보내다, 신고","s":"몸(尸)을 뻗어 밭(田) 끝까지 '닿는다'."},
{"c":"進","m":"나아가다, 진행하다","s":"새(隹)는 뒤로 걷지 않고 길(辶)을 '나아간다'."},
{"c":"渋","m":"떫다, 수수하다, 막히다","s":"물(氵)이 멈춰(止) 고여 맛이 '떫다'."},
{"c":"診","m":"진찰하다","s":"말(言)로 물으며 몸을 살펴 '진찰한다'."},
{"c":"察","m":"살피다, 알아차리다","s":"집(宀)에서 제사(祭)를 지낼 때 꼼꼼히 '살핀다'."},
{"c":"先","m":"먼저, 앞, 끝","s":"사람(儿) 위로 발이 앞서 나간다 → '먼저'."},
{"c":"共","m":"함께","s":"두 손으로 함께 받쳐 든 모양 → '함께'."},
{"c":"通","s":"길(辶)이 통(甬)처럼 뻥 뚫려 '통한다'."},
{"c":"詰","m":"채우다, 막히다, 따지다","s":"말(言)을 길하게(吉) 꽉 '채워' 따진다."},
{"c":"情","m":"정, 마음, 사정","s":"마음(忄)이 푸르게(青) 맑은 '정'."},
{"c":"報","m":"알리다, 갚다, 보도","s":"죄인을 잡아 손(又)으로 '알리고' 갚는다."},
{"c":"現","m":"나타나다, 지금","s":"옥(王)을 보니(見) 빛이 '나타난다'."},
{"c":"在","m":"있다, 존재하다","s":"흙(土) 위에 사람이 머물러 '있다'."},
{"c":"有","m":"있다, 가지다","s":"손에 고기(月)를 쥐고 '있다'."},
{"c":"名","m":"이름","s":"저녁(夕)엔 어두워 입(口)으로 '이름'을 부른다."},
{"c":"角","m":"뿔, 모서리, 각","s":"짐승의 뾰족한 '뿔' 모양 → '모서리'."},
{"c":"容","m":"얼굴, 담다, 용","s":"집(宀) 안 골짜기(谷)처럼 넉넉히 '담는다'."},
{"c":"器","m":"그릇, 기구","s":"개(犬)가 네 개의 그릇(口)을 지킨다 → '그릇'."},
{"c":"比","m":"견주다, 비교하다","s":"두 사람(匕匕)이 나란히 서서 '견준다'."},
{"c":"複","m":"겹치다, 복잡하다","s":"옷(衤)을 다시(复) 겹쳐 입는다 → '겹치다'."},
{"c":"数","m":"수, 세다, 몇","s":"여자(女)가 쌀(米)을 두드리며(攵) 하나둘 '센다'."},
{"c":"血","m":"피","s":"그릇(皿)에 한 방울 떨어진 '피'."},
{"c":"圧","m":"누르다, 압력","s":"언덕(厂) 아래 흙(土)을 꾹 '누른다'."},
{"c":"夕","m":"저녁","s":"반쯤 뜬 달 → '저녁'."},
{"c":"日","s":"동그란 해 가운데 점 → '해, 날'."},
{"c":"件","m":"건, 일, 사건","s":"사람(亻)과 소(牛)가 얽힌 '일, 사건'."},
{"c":"冷","m":"차갑다, 식다","s":"얼음(冫) 위에서 명령(令)을 들으니 '차갑다'."},
{"c":"検","m":"검사하다","s":"나무(木) 표를 하나하나 모아(㑒) '검사한다'."},
{"c":"査","m":"조사하다","s":"나무(木) 아래 또(且) 들여다보며 '조사한다'."},
{"c":"絵","m":"그림","s":"실(糸)을 모아(会) 수놓은 '그림'."},
{"c":"画","m":"그림, 그리다, 획","s":"밭(田)의 경계를 그은 '그림, 획'."},
{"c":"胃","m":"위(소화 기관)","s":"몸(月) 위에 밭(田)처럼 음식을 담는 '위'."},
{"c":"笑","m":"웃다","s":"대나무(竹)가 바람에 휘듯 사람이 몸을 젖히며 '웃는다'."},
{"c":"顔","m":"얼굴","s":"선비(彦)의 머리(頁) 앞면 → '얼굴'."},
{"c":"黒","m":"검다","s":"마을(里) 아래 불(灬)을 때니 그을음으로 '검다'."},
{"c":"般","m":"일반, 무리","s":"배(舟)를 몽둥이(殳)로 저어 두루 옮긴다 → '일반'."},
{"c":"資","m":"재물, 자료, 바탕","s":"버금(次) 가는 돈(貝) → '재물, 자원'."},
{"c":"源","m":"근원, 원천","s":"물(氵)이 언덕(原)에서 솟는 '근원'."},
{"c":"染","m":"물들이다, 스며들다","s":"물(氵)에 아홉(九) 번 나무(木) 즙을 넣어 '물들인다'."},
{"c":"防","m":"막다, 방어하다","s":"언덕(⻖)을 사방(方)에 쌓아 '막는다'."},
{"c":"乾","m":"마르다, 말리다","s":"해(日)가 높이 떠 땅이 '마른다'."},
{"c":"親","m":"부모, 친하다","s":"나무(木) 위에 서서(立) 자식을 보는(見) '부모'."},
{"c":"戚","m":"친척, 겨레","s":"창(戈)을 든 작은(小) 무리 → '친척'."},
{"c":"偶","m":"짝, 우연, 짝수","s":"사람(亻)이 원숭이(禺) 인형과 '짝'을 이룬다."},
{"c":"然","s":"개(犬)고기를 불(灬)에 구우니 '그러하다'."},
{"c":"迷","m":"헤매다, 망설이다","s":"길(辶)이 쌀(米)알처럼 여러 갈래라 '헤맨다'."},
{"c":"干","m":"말리다, 방패, 범하다","s":"끝이 갈라진 막대 → '방패', 그리고 '말리다'."},
{"c":"登","m":"오르다","s":"두 발(癶)로 받침대(豆) 위에 '오른다'."},
{"c":"希","m":"바라다, 드물다","s":"천(巾)을 엮듯 성기게 짠 '드문' 것을 '바란다'."},
{"c":"望","m":"바라다, 바라보다","s":"달(月)을 높이 서서(王) '바라본다'."},
{"c":"吠","m":"짖다","s":"개(犬)가 입(口)을 벌려 '짖는다'."},
{"c":"追","s":"길(辶)에서 언덕(𠂤)을 넘어 '뒤쫓는다'."},
{"c":"越","m":"넘다, 넘기다","s":"달려가(走) 창(戉)처럼 훌쩍 '넘는다'."},
{"c":"詳","m":"자세하다","s":"말(言)을 양(羊)털 하나하나 짚듯 '자세하다'."},
{"c":"非","m":"아니다, 그르다","s":"새의 두 날개가 서로 등을 진다 → '아니다'."},
{"c":"定","m":"정하다, 정해지다","s":"집(宀) 안에 발(疋)을 딱 붙이고 '정한다'."},
{"c":"不","s":"선 아래로 뿌리가 갈라진 모양 → '아니다'."},
{"c":"安","m":"편안하다, 싸다","s":"집(宀) 안에 여자(女)가 있어 '편안하다'."},
{"c":"予","m":"미리, 나","s":"베틀 북이 미리 실을 보내는 모양 → '미리'."},
{"c":"参","m":"참가하다, 뵈다(참배)","s":"머리 위 별 셋과 빛줄기(彡) → 함께 '참여한다'."},
{"c":"加","m":"더하다, 가입하다","s":"힘(力)에 입(口)까지 '더한다'."},
{"c":"盛","m":"담다, 성하다, 번성하다","s":"그릇(皿)에 이룰(成) 만큼 수북이 '담는다'."},
{"c":"発","s":"두 발(癶)로 힘차게 출발한다 → '떠나다, 일어나다'."},
{"c":"展","m":"펴다, 전시하다","s":"몸(尸) 아래 옷(衣)을 쫙 '편다'."},
{"c":"抱","m":"안다, 품다","s":"손(扌)으로 감싸(包) '안는다'."},
{"c":"異","m":"다르다","s":"밭(田) 아래 두 손을 든 이상한 탈 → '다르다'."},
{"c":"駐","m":"머무르다, 주차","s":"말(馬)이 주인(主) 곁에 '머문다'."},
{"c":"車","m":"차, 수레","s":"위에서 본 바퀴 달린 '수레'."},
{"c":"去","m":"가다, 떠나다, 지난","s":"흙(土) 위의 사람이 작게(厶) 멀어지며 '떠난다'."},
{"c":"泊","m":"묵다, 숙박하다","s":"물(氵)가 하얀(白) 여관에 '묵는다'."},
{"c":"暖","m":"따뜻하다","s":"해(日) 아래 손을 마주 대니 '따뜻하다'."},
{"c":"伝","m":"전하다, 전해지다","s":"사람(亻)이 말(云)을 '전한다'."},
{"c":"言","m":"말, 말하다","s":"입(口) 위로 말이 줄줄이 나온다 → '말'."},
{"c":"延","m":"늘이다, 미루다, 연장","s":"발(止)을 질질 끌며(廴) 길게 '늘인다'."},
{"c":"枯","m":"마르다, 시들다","s":"나무(木)가 오래(古)되어 '말라 죽는다'."},
{"c":"訓","m":"가르치다, 훈(뜻으로 읽기)","s":"말(言)을 냇물(川)처럼 흘려 '가르친다'."},
{"c":"練","m":"익히다, 단련하다","s":"실(糸)을 동쪽(東) 볕에 몇 번이고 '단련한다'."},
{"c":"材","m":"재료, 재목","s":"나무(木)의 재주(才) → 쓸모 있는 '재료'."},
{"c":"料","m":"요금, 재료, 헤아리다","s":"쌀(米)을 말(斗)로 '헤아려' 매기는 '요금'."}
]
