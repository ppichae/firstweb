[
{"c":"穴","m":"구멍","s":"지붕(宀) 아래 양쪽으로 벌어진 '구멍'."},
{"c":"癖","m":"버릇, 습관","s":"병(疒)처럼 몸에 붙어 떨어지지 않는 '버릇'."},
{"c":"栄","m":"번영하다, 영광","s":"나무(木) 위에 불꽃(⺌)처럼 꽃이 피어 '번영한다'."},
{"c":"養","m":"기르다, 영양","s":"양(羊)에게 먹이(食)를 주어 '기른다'."},
{"c":"隠","m":"숨기다, 숨다","s":"언덕(⻖) 뒤에 마음(心)을 '숨긴다'."},
{"c":"破","m":"깨다, 찢다, 깨지다","s":"돌(石)로 가죽(皮)을 쳐서 '찢는다'."},
{"c":"編","m":"엮다, 편집하다, 뜨개질하다","s":"실(糸)로 문서(扁)를 '엮는다'."},
{"c":"戦","m":"싸우다, 전쟁","s":"창(戈)을 들고 홀로(単) 맞서 '싸운다'."},
{"c":"興","m":"일으키다, 흥미","s":"여러 손이 함께 들어 올려 '일으킨다' → '흥'."},
{"c":"味","m":"맛, 맛보다","s":"입(口)으로 아직(未) 덜 익은 것을 '맛본다'."},
{"c":"香","m":"향기, 향","s":"벼(禾)를 해(日)에 말리면 나는 '향기'."},
{"c":"演","m":"연기하다, 펼치다","s":"물(氵)이 넓게 퍼지듯 무대에서 '펼친다'."},
{"c":"奏","m":"연주하다, 아뢰다","s":"두 손으로 악기를 받쳐 들고 '연주한다'."},
{"c":"惜","m":"아깝다, 아끼다","s":"마음(忄)에 옛날(昔)이 남아 '아깝다'."},
{"c":"傷","m":"상처, 다치다","s":"사람(亻)이 햇볕(昜)에 데어 생긴 '상처'."},
{"c":"頼","m":"부탁하다, 의지하다","s":"묶은(束) 짐을 머리(頁)에 이고 남에게 '의지한다'."},
{"c":"特","m":"특별하다, 특히","s":"절(寺)에 바친 소(牛)는 '특별하다'."},
{"c":"囲","m":"둘러싸다, 둘레","s":"우물(井)을 상자(囗)로 '둘러싼다'."},
{"c":"許","m":"허락하다, 용서하다","s":"말(言)로 낮(午)에 '좋다'고 '허락한다'."},
{"c":"姿","m":"모습, 맵시","s":"버금(次) 가는 여자(女)의 고운 '모습'."},
{"c":"勢","m":"기세, 형세","s":"힘(力)을 다해 나무를 심는(埶) '기세'."},
{"c":"確","m":"확실하다, 확인하다","s":"돌(石)처럼 단단히 새(隹)가 앉아 '확실하다'."},
{"c":"農","m":"농사, 농업","s":"구부린 허리(辰)로 밭을 가꾸는 '농사'."},
{"c":"沈","m":"가라앉다, 가라앉히다","s":"물(氵)에 사람이 쑥 '잠긴다'."},
{"c":"緒","m":"실마리, 함께(一緒)","s":"실(糸)을 쥔 사람(者) → 일의 '실마리', 함께하는 '緒'."},
{"c":"底","m":"밑, 바닥","s":"집(广) 아래 가장 낮은(氐) 곳 → '바닥'."},
{"c":"較","m":"비교하다","s":"수레(車)끼리 사귀듯(交) 나란히 '비교한다'."},
{"c":"床","m":"바닥, 마루, 잠자리","s":"집(广) 안에 나무(木)를 깐 '마루'."},
{"c":"落","m":"떨어지다, 떨어뜨리다","s":"풀(艹)잎이 물(氵)에 각각(各) '떨어진다'."},
{"c":"請","m":"청하다, 맡다","s":"말(言)을 맑게(青) 하여 '청한다'."},
{"c":"明","m":"밝다, 분명하다, 다음(明日)","s":"해(日)와 달(月)이 함께 있으니 '밝다'."},
{"c":"混","m":"섞다, 섞이다, 붐비다","s":"물(氵)에 여러 형(昆)제가 뒤섞인다 → '섞다'."},
{"c":"純","m":"순수하다","s":"실(糸)이 막 돋은 싹(屯)처럼 '순수하다'."},
{"c":"孫","m":"손자, 손주","s":"아이(子)에 실(系)처럼 이어진 '손자'."},
{"c":"仕","m":"섬기다, 일하다","s":"사람(亻)이 선비(士)를 '섬긴다' → '일'."},
{"c":"恐","m":"두려워하다, 무섭다","s":"마음(心)이 구멍 난 듯(巩) 떨리니 '두렵다'."},
{"c":"怖","m":"무섭다, 두려워하다","s":"마음(忄)이 천(布)처럼 펄럭이며 '무섭다'."},
{"c":"訳","m":"번역하다, 이유, 까닭","s":"말(言)을 자(尺)로 재듯 옮겨 '번역한다', 그리고 '까닭'."},
{"c":"悪","m":"나쁘다, 악","s":"버금(亜)가는 마음(心) → '나쁘다'."},
{"c":"年","m":"해, 나이","s":"벼를 베어 지고 가는 사람 → 한 '해'가 간다."},
{"c":"次","m":"다음, 차례","s":"얼음(冫) 위에서 하품(欠)하며 '다음' 차례를 기다린다."},
{"c":"同","m":"같다, 한가지","s":"덮개(冂) 아래 한(一) 입(口)으로 '같은' 말을 한다."},
{"c":"入","m":"들다, 넣다","s":"사람이 고개를 숙이고 안으로 '들어간다'."},
{"c":"好","m":"좋아하다, 좋다","s":"여자(女)가 아이(子)를 안으니 '좋다'."},
{"c":"奪","m":"빼앗다","s":"큰(大) 새(隹)를 손(寸)으로 '빼앗는다'."},
{"c":"注","m":"붓다, 주의하다, 주문","s":"물(氵)을 주인(主)이 잔에 '붓는다'."},
{"c":"近","m":"가깝다","s":"길(辶)에 도끼(斤)를 두면 손 닿는 '가까운' 곳."},
{"c":"収","m":"거두다, 수입","s":"손(又)으로 얽힌 것을 '거둔다'."},
{"c":"急","m":"급하다, 서두르다","s":"마음(心)이 쫓기듯(刍) '급하다'."},
{"c":"約","m":"약속, 대략","s":"실(糸)로 작은 국자(勺)를 묶어 '약속'한다."},
{"c":"何","m":"무엇, 몇, 어찌","s":"사람(亻)이 옳은지(可) 묻는다 → '무엇'."},
{"c":"第","m":"차례, 제~","s":"대나무(竹) 조각에 차례대로 번호를 매긴 '제~'."},
{"c":"上","m":"위, 오르다","s":"선(一) 위로 점이 올라간 '위'."},
{"c":"勉","m":"힘쓰다, 공부(勉強)","s":"힘(力)을 다해 벗어나려(免) '힘쓴다'."},
{"c":"強","m":"강하다, 억지로","s":"활(弓)처럼 단단한 벌레(虫) → '강하다'."},
{"c":"輝","m":"빛나다","s":"빛(光)이 군대(軍)의 깃발처럼 '빛난다'."},
{"c":"余","m":"남다, 나머지, 여분","s":"지붕(𠆢) 아래 넉넉히 '남는다'."},
{"c":"止","m":"멈추다, 그치다","s":"땅을 딛고 선 발 → '멈춘다'."},
{"c":"渡","m":"건너다, 건네다","s":"물(氵)을 정도(度)껏 헤아려 '건넌다'."},
{"c":"声","m":"소리, 목소리","s":"선비(士)가 내는 '목소리'."},
{"c":"未","m":"아직 ~않다, 미~","s":"나무(木) 가지 끝이 '아직' 덜 자랐다."},
{"c":"来","m":"오다, 다음(来年)","s":"보리 이삭이 하늘에서 '온다'는 그림으로 기억해요."},
{"c":"貧","m":"가난하다","s":"돈(貝)을 나누어(分) 주고 나니 '가난하다'."},
{"c":"植","m":"심다, 식물","s":"나무(木)를 곧게(直) '심는다'."},
{"c":"緊","m":"팽팽하다, 긴급","s":"실(糸)을 단단히(臤) 당겨 '팽팽하다'."},
{"c":"訪","m":"방문하다, 찾다","s":"말(言)을 들고 사방(方)으로 '찾아간다'."},
{"c":"翻","m":"뒤집다, 번역하다","s":"깃(羽)을 차례(番)로 '뒤집는다'."},
{"c":"活","m":"살다, 활동","s":"물(氵)이 혀(舌)를 적셔 '살아 움직인다'."},
{"c":"建","m":"세우다, 짓다","s":"붓(聿)으로 설계하고 길게(廴) 늘려 '세운다'."},
{"c":"設","m":"설치하다, 베풀다","s":"말(言)로 지시하고 몽둥이(殳)로 쳐서 '설치한다'."},
{"c":"縮","m":"줄다, 줄이다","s":"실(糸)이 묵는 집(宿)에서 '쪼그라든다'."},
{"c":"鮮","m":"신선하다, 선명하다","s":"물고기(魚)와 양(羊)이 갓 잡혀 '신선하다'."},
{"c":"締","m":"죄다, 매다, 마감","s":"실(糸)을 임금(帝)처럼 단단히 '죈다'."},
{"c":"似","m":"닮다, 비슷하다","s":"사람(亻)이 써(以) 놓은 듯 '닮았다'."},
{"c":"沸","m":"끓다, 끓이다","s":"물(氵)이 아니라고(弗) 외치듯 부글부글 '끓는다'."},
{"c":"騰","m":"오르다, 뛰어오르다","s":"말(馬)이 힘차게 '뛰어오른다'."},
{"c":"慰","m":"위로하다","s":"마음(心)을 벼슬(尉)처럼 다독여 '위로한다'."},
{"c":"弄","m":"가지고 놀다, 희롱하다","s":"구슬(王)을 두 손(廾)으로 '만지작거린다'."},
{"c":"悟","m":"깨닫다","s":"마음(忄)으로 나(吾)를 알아 '깨닫는다'."},
{"c":"唆","s":"입(口)으로 몰래 꾀어 '부추긴다'."},
{"c":"謙","m":"겸손하다","s":"말(言)을 겸하여(兼) 낮추니 '겸손하다'."},
{"c":"虚","m":"비다, 헛되다","s":"호랑이(虍) 굴이 텅 '비어' 있다."},
{"c":"滑","m":"미끄러지다, 매끄럽다","s":"물(氵)에 뼈(骨)가 '미끄러진다'."},
{"c":"承","m":"잇다, 받들다, 승낙","s":"두 손으로 받들어 '이어받는다'."},
{"c":"諾","m":"허락하다, 승낙","s":"말(言)로 '좋다(若)'고 '허락한다'."},
{"c":"弾","m":"튀다, 탄알, 연주하다","s":"활(弓)이 홀로(単) 튕겨 '탄알'을 쏜다, 줄을 '탄다'."},
{"c":"窮","m":"궁하다, 다하다","s":"구멍(穴)에 몸(身)이 활(弓)처럼 끼어 '궁하다'."},
{"c":"喚","m":"부르다, 외치다","s":"입(口)을 크게 벌려 '부른다'."},
{"c":"水","m":"물","s":"가운데 줄기로 물방울이 흩어지는 '물'."},
{"c":"臭","m":"냄새, 냄새나다","s":"코(自) 큰(大) 개가 맡는 '냄새'."},
{"c":"況","m":"상황, 하물며","s":"물(氵)가에 형(兄)이 서서 보는 '상황'."},
{"c":"景","m":"경치, 풍경","s":"해(日) 아래 서울(京)의 '경치'."},
{"c":"熟","m":"익다, 익숙하다","s":"불(灬)에 오래 두어 '익힌다'."},
{"c":"倹","m":"검소하다","s":"사람(亻)이 모두(㑒) 아껴 '검소하다'."},
{"c":"構","m":"짜다, 구조, 상관하다","s":"나무(木)를 엇갈려 짜서 '구조'를 만든다."},
{"c":"喫","m":"마시다, 먹다(喫茶·喫煙)","s":"입(口)으로 맺은(契) 약속처럼 꼭 '마신다'."},
{"c":"暇","m":"틈, 여가, 한가함","s":"해(日)가 남아 거짓(叚)말처럼 생긴 '틈'."},
{"c":"鈍","m":"둔하다, 무디다","s":"쇠(金)가 막 돋은 싹(屯)처럼 '무디다'."},
{"c":"閲","m":"훑어보다, 열람하다","s":"문(門) 안에서 기쁘게(兑) 책을 '훑어본다'."},
{"c":"崇","m":"높이다, 숭배하다","s":"산(山) 위 제단(宗)을 '높인다'."},
{"c":"裁","m":"자르다, 재판하다","s":"옷(衣)을 창(戈)처럼 '마름질한다' → '재판'."},
{"c":"胸","m":"가슴","s":"몸(月)에서 감싼(匈) 곳 → '가슴'."},
{"c":"併","m":"아우르다, 함께","s":"사람(亻)이 나란히(并) 서서 '아우른다'."},
{"c":"筆","m":"붓, 글씨","s":"대나무(竹) 대롱에 붓(聿)을 끼운 '붓'."},
{"c":"脳","m":"뇌","s":"몸(月)에서 생각이 모이는 '뇌'."},
{"c":"始","m":"시작하다, 처음","s":"여자(女)가 태어나는(台) 때 → '시작'."},
{"c":"傾","m":"기울다, 기울이다","s":"사람(亻)이 고개(頃)를 '기울인다'."},
{"c":"議","m":"의논하다, 회의","s":"말(言)로 옳은(義) 것을 '의논한다'."},
{"c":"保","m":"지키다, 유지하다","s":"사람(亻)이 아이를 업고 '지킨다'."},
{"c":"和","m":"화합하다, 부드럽다, 일본","s":"벼(禾)를 함께 나누어 먹는 입(口) → '화합'."},
{"c":"程","m":"정도, 과정","s":"벼(禾)를 드리고(呈) 재는 '정도'."},
{"c":"遠","m":"멀다","s":"긴 옷(袁)을 입고 길(辶)을 가니 '멀다'."},
{"c":"脱","m":"벗다, 벗어나다","s":"몸(月)에서 기쁘게(兑) 옷을 '벗는다'."},
{"c":"却","m":"물리치다, 도리어","s":"무릎 꿇은 사람(卩)이 가다(去) '물러난다'."},
{"c":"頑","m":"완고하다, 끈질기다","s":"으뜸(元)이라고 머리(頁)를 고집스럽게 세운다 → '완고하다'."},
{"c":"丈","m":"길이, 튼튼함(大丈夫)","s":"열(十) 자를 손으로 재는 긴 '길이'."},
{"c":"潜","m":"잠기다, 숨다, 잠수","s":"물(氵) 속에 몰래 '숨는다'."},
{"c":"政","m":"정치","s":"바르게(正) 회초리(攵)를 들고 다스리는 '정치'."},
{"c":"卓","m":"탁자, 뛰어나다","s":"높은 곳에 올려 둔 '탁자', 그리고 '뛰어나다'."},
{"c":"芳","m":"향기롭다, 꽃답다","s":"풀(艹)향이 사방(方)으로 퍼져 '향기롭다'."},
{"c":"管","m":"관, 관리하다","s":"대나무(竹)로 만든 대롱 → '관', 그리고 '관리'."},
{"c":"轄","m":"관할하다","s":"수레(車)바퀴를 해(害)치지 않게 '다스린다'."},
{"c":"環","m":"고리, 둘레, 환경","s":"구슬(王)을 둥글게 이은 '고리'."},
{"c":"周","m":"둘레, 두루","s":"성벽을 '두루' 둘러싼 '둘레'."},
{"c":"誇","m":"자랑하다","s":"말(言)을 크게 부풀려 '자랑한다'."},
{"c":"密","m":"빽빽하다, 비밀","s":"집(宀) 안에 꼭 숨긴 '비밀'."},
{"c":"試","m":"시험하다, 시도하다","s":"말(言)로 방식(式)을 '시험한다'."},
{"c":"買","m":"사다","s":"그물(罒)에 돈(貝)을 담아 '산다'."},
{"c":"迫","m":"닥치다, 다그치다","s":"길(辶)에 하얀(白) 것이 바짝 '다가온다'."},
{"c":"鋭","m":"날카롭다, 예리하다","s":"쇠(金)를 기쁘게(兑) 갈아 '날카롭다'."},
{"c":"荒","m":"거칠다, 황폐하다","s":"풀(艹)만 무성하고 물이 망가진(亡) '거친' 땅."},
{"c":"危","m":"위험하다","s":"절벽(厂) 끝에 웅크린 사람(卩) → '위험하다'."},
{"c":"元","m":"으뜸, 근원, 원래","s":"사람(儿) 위의 머리(二) → '으뜸, 근원'."},
{"c":"芸","m":"재주, 예술","s":"풀(艹)을 기르듯 말(云)로 익힌 '재주'."},
{"c":"腐","m":"썩다","s":"관청(府) 고기(肉)가 오래 두어 '썩는다'."},
{"c":"敗","m":"지다, 패하다","s":"돈(貝)을 회초리(攵)로 쳐서 깨뜨리니 '패한다'."},
{"c":"粗","m":"거칠다, 엉성하다","s":"쌀(米)을 대충(且) 찧어 '거칠다'."},
{"c":"粘","m":"끈끈하다, 끈기","s":"쌀(米)밥이 자리(占)에 '들러붙는다'."},
{"c":"膜","m":"막, 얇은 껍질","s":"몸(月)을 덮은(莫) 얇은 '막'."},
{"c":"寿","m":"목숨, 장수, 축하","s":"손(寸)으로 받든 긴 '목숨' → '장수'."},
{"c":"戒","m":"경계하다, 타이르다","s":"두 손으로 창(戈)을 들고 '경계한다'."},
{"c":"誓","m":"맹세하다","s":"말(言)을 꺾을(折) 수 없이 '맹세한다'."},
{"c":"錯","m":"섞이다, 착각","s":"쇠(金)와 옛것(昔)이 뒤섞여 '착각'한다."},
{"c":"航","m":"항해하다, 운항","s":"배(舟)가 높이 솟아(亢) 바다를 '건넌다'."},
{"c":"委","m":"맡기다, 위원","s":"벼(禾)를 여자(女)에게 '맡긴다'."},
{"c":"託","m":"맡기다, 부탁하다","s":"말(言)로 몸을 기대어(乇) '부탁한다'."},
{"c":"任","m":"맡기다, 임무","s":"사람(亻)이 짐(壬)을 지고 '맡는다'."},
{"c":"爽","m":"상쾌하다, 시원하다","s":"큰(大) 사람 양옆으로 바람이 통해 '상쾌하다'."},
{"c":"撃","m":"치다, 공격하다","s":"수레(車)와 몽둥이(殳)와 손(手)으로 '친다'."},
{"c":"風","m":"바람, 풍습, ~풍","s":"돛(几) 안에서 벌레(虫)가 흔들리는 '바람'."},
{"c":"潮","m":"조수, 바닷물","s":"물(氵)이 아침(朝)마다 밀려오는 '조수'."},
{"c":"撤","m":"거두다, 철수하다","s":"손(扌)으로 모두 '거두어들인다'."},
{"c":"補","m":"보충하다, 기우다","s":"옷(衤)을 크게(甫) '기워' 보충한다."},
{"c":"填","m":"메우다, 채우다","s":"흙(土)으로 참(真)되게 빈 곳을 '메운다'."},
{"c":"脆","m":"무르다, 약하다","s":"몸(月)이 위험(危)할 만큼 '무르다'."},
{"c":"責","m":"책임, 꾸짖다","s":"돈(貝)을 갚으라고 '꾸짖는다' → '책임'."},
{"c":"咎","m":"탓하다, 허물","s":"입(口)으로 남의 '허물'을 '탓한다'."},
{"c":"契","m":"맺다, 계약","s":"칼(刀)로 새기고 크게(大) '약속을 맺는다'."},
{"c":"拠","s":"손(扌)으로 짚고 '의지한다' → '근거'."},
{"c":"祖","m":"조상, 할아버지","s":"제단(礻)에 또(且) 모시는 '조상'."},
{"c":"寄","m":"다가가다, 들르다, 맡기다","s":"집(宀)에 기이하게(奇) '들른다'."},
{"c":"還","m":"돌아오다, 돌려주다","s":"길(辶)을 한 바퀴 돌아 '돌아온다'."},
{"c":"呈","m":"드리다, 나타내다","s":"입(口)으로 임금(王)에게 '드린다'."},
{"c":"繰","m":"(실을) 잣다, 넘기다, 되풀이하다","s":"실(糸)을 새가 울 듯 빙빙 '감아 넘긴다'."},
{"c":"連","m":"잇다, 데리고 가다","s":"수레(車)가 길(辶)에 줄줄이 '이어진다'."}
]
