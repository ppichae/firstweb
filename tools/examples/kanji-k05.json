[
{"c":"反","m":"반대, 돌이키다, 젖히다","s":"언덕(厂) 아래에서 손(又)을 뒤로 '젖힌다' → '반대'."},
{"c":"衰","m":"쇠하다, 약해지다","s":"옷(衣) 사이로 기운이 빠져 '쇠약해진다'."},
{"c":"骨","m":"뼈","s":"살(月) 위에 드러난 '뼈'."},
{"c":"戻","m":"되돌리다, 돌아오다","s":"문(戸) 앞에서 개(犬)가 '되돌아온다'."},
{"c":"譲","m":"양보하다, 물려주다","s":"말(言)을 부드럽게 하여 자리를 '양보한다'."},
{"c":"険","m":"험하다, 위험","s":"언덕(⻖)이 모두(㑒) 가파르니 '험하다'."},
{"c":"態","m":"모습, 태도","s":"곰(能)이 마음(心)을 드러낸 '태도'."},
{"c":"騒","m":"떠들다, 소란","s":"말(馬)이 벌레(虫)에 물려 '소란'을 피운다."},
{"c":"諭","m":"타이르다, 깨우치다","s":"말(言)로 차근차근 '타이른다'."},
{"c":"秩","m":"차례, 질서","s":"벼(禾)를 잃지(失) 않게 '차례'대로 쌓는다."},
{"c":"序","m":"차례, 처음","s":"집(广) 안에 미리(予) 정한 '차례'."},
{"c":"伏","m":"엎드리다, 숨다","s":"사람(亻) 옆에 개(犬)가 '엎드린다'."},
{"c":"朗","m":"밝다, 명랑하다","s":"좋은(良) 달(月)빛처럼 '밝다'."},
{"c":"軌","m":"궤도, 바퀴 자국","s":"수레(車)가 아홉(九) 번 지나간 '바퀴 자국'."},
{"c":"跡","m":"자취, 흔적","s":"발(⻊)이 또(亦) 남긴 '자취'."},
{"c":"偏","m":"치우치다","s":"사람(亻)이 한쪽 문(扁)으로만 '치우친다'."},
{"c":"矛","m":"창","s":"긴 자루 끝에 날이 달린 '창'."},
{"c":"盾","m":"방패","s":"눈(目) 앞을 가리는 '방패'."},
{"c":"賄","m":"뇌물, 꾸려 가다(賄う)","s":"돈(貝)이 있는(有) 쪽으로 몰래 건네는 '뇌물'."},
{"c":"軽","m":"가볍다","s":"수레(車)가 빈 채로 달리니 '가볍다'."},
{"c":"率","m":"비율, 거느리다","s":"실을 가운데로 모아 '거느린다' → '비율'."},
{"c":"散","m":"흩어지다, 흩다, 산책","s":"회초리(攵)로 털어 '흩어지게' 한다."},
{"c":"紛","m":"어지럽다, 섞이다, 분실","s":"실(糸)이 나뉘어(分) '어지럽게' 엉킨다."},
{"c":"快","m":"상쾌하다, 즐겁다","s":"마음(忄)이 터진(夬) 듯 '시원하다'."},
{"c":"挙","m":"들다, 거행하다, 모두","s":"여러 손(手)이 함께 '들어 올린다'."},
{"c":"助","m":"돕다, 도움","s":"또(且) 힘(力)을 보태 '돕는다'."},
{"c":"奮","m":"떨치다, 분발하다","s":"큰(大) 새(隹)가 밭(田)에서 날개를 '떨친다'."},
{"c":"闘","m":"싸우다, 투쟁","s":"문(門) 안에서 맞붙어 '싸운다'."},
{"c":"死","m":"죽다, 죽음","s":"뼈(歹) 옆에 사람(匕)이 쓰러져 '죽는다'."},
{"c":"慮","s":"호랑이(虍)를 만난 듯 마음(心)으로 깊이 '생각한다'."},
{"c":"没","m":"가라앉다, 빠지다, 없다","s":"물(氵)에 몽둥이(殳)가 '빠진다'."},
{"c":"熱","m":"뜨겁다, 열","s":"불(灬) 위에서 힘써 심으니(埶) '뜨겁다'."},
{"c":"尺","m":"자, 길이","s":"엄지와 검지를 벌려 재는 '자'."},
{"c":"準","m":"기준, 준하다, 준비","s":"물(氵) 위의 새(隹)처럼 수평을 잡는 '기준'."},
{"c":"肝","m":"간, 중요한 것","s":"몸(月)에서 방패(干)처럼 지키는 '간'."},
{"c":"辛","m":"맵다, 괴롭다","s":"바늘 끝처럼 찌르는 맛 → '맵다', '괴롭다'."},
{"c":"慣","m":"익숙해지다, 버릇","s":"마음(忄)에 꿰듯(貫) 배어 '익숙해진다'."},
{"c":"兆","m":"조짐, 조(숫자)","s":"거북 등의 갈라진 금 → 앞일의 '조짐'."},
{"c":"烈","m":"맹렬하다, 세차다","s":"줄지어(列) 타오르는 불(灬) → '맹렬하다'."},
{"c":"勇","m":"용감하다, 용기","s":"힘(力)이 솟아 '용감하다'."},
{"c":"敢","m":"감히, 과감히","s":"손에 회초리(攵)를 들고 '감히' 나선다."},
{"c":"忠","m":"충성, 정성","s":"마음(心)의 한가운데(中) → '충성'."},
{"c":"慕","m":"그리워하다, 사모하다","s":"해가 저무는(莫) 때 마음(⺗)으로 '그리워한다'."},
{"c":"施","m":"베풀다, 시행하다","s":"깃발(方) 아래 널리 '베푼다'."},
{"c":"錠","m":"자물쇠, 알약","s":"쇠(金)로 정한(定) 자리를 잠그는 '자물쇠'."},
{"c":"阻","s":"언덕(⻖)이 또(且) 가로막아 '막는다'."},
{"c":"監","m":"살피다, 감독하다","s":"엎드려 물그릇(皿)에 비친 얼굴을 '살핀다'."},
{"c":"督","m":"감독하다, 재촉하다","s":"아재(叔)가 눈(目)을 부릅뜨고 '감독한다'."},
{"c":"透","m":"비치다, 통하다, 투명","s":"길(辶)이 빼어나게(秀) 뚫려 '비친다'."},
{"c":"恩","m":"은혜","s":"원인(因)을 마음(心)에 새기는 '은혜'."},
{"c":"恵","m":"은혜, 베풀다","s":"마음(心) 위에 실패를 감듯 정성을 '베푼다'."},
{"c":"臨","s":"신하(臣)가 몸을 숙여 물건(品)을 내려다본다 → '임하다'."},
{"c":"如","m":"같다, ~와 같이","s":"여자(女)가 입(口)으로 말한 그대로 → '같다'."},
{"c":"護","m":"지키다, 보호하다","s":"말(言)로 새를 감싸 '지킨다'."},
{"c":"刺","m":"찌르다, 가시, 자극","s":"가시나무(朿)를 칼(刂)처럼 '찌른다'."},
{"c":"激","m":"격하다, 세차다","s":"물(氵)이 바위에 부딪혀 '세차다'."},
{"c":"口","m":"입, 구멍, 출입구","s":"벌린 '입' 모양."},
{"c":"担","m":"메다, 담당하다","s":"손(扌)으로 아침(旦)부터 짐을 '멘다'."},
{"c":"穏","m":"평온하다, 온화하다","s":"벼(禾)가 숨은(隠) 듯 고요해 '평온하다'."},
{"c":"拮","m":"버티다, 맞서다(拮抗)","s":"손(扌)으로 길하게(吉) 힘을 겨루며 '버틴다'."},
{"c":"抗","m":"맞서다, 저항하다","s":"손(扌)을 높이(亢) 들어 '맞선다'."},
{"c":"批","m":"비평하다","s":"손(扌)으로 견주어(比) '비평한다'."},
{"c":"判","m":"판단하다, 도장","s":"반(半)으로 칼(刂)처럼 갈라 '판단한다'."},
{"c":"邪","m":"사악하다, 간사하다","s":"어금니(牙)를 드러낸 마을(⻏)의 '사악한' 기운."},
{"c":"遮","m":"가리다, 차단하다","s":"길(辶)을 여러(庶) 사람이 '가로막는다'."},
{"c":"誘","m":"꾀다, 권유하다","s":"말(言)로 빼어나게(秀) '꾄다'."},
{"c":"致","m":"이르다, 하다(겸손), 일치","s":"목적지(至)까지 회초리(攵)로 몰아 '이른다'."},
{"c":"遺","m":"남기다, 잃다","s":"길(辶)에 귀한(貴) 것을 '남기고' 간다."},
{"c":"憾","m":"섭섭하다, 유감","s":"마음(忄)에 느낌(感)이 남아 '섭섭하다'."},
{"c":"鎖","m":"쇠사슬, 잠그다","s":"쇠(金)를 작은(小) 고리로 이은 '쇠사슬'."},
{"c":"遣","m":"보내다, 파견하다","s":"길(辶)로 사람을 '보낸다' → '파견'."},
{"c":"憤","m":"분하다, 성내다","s":"마음(忄)이 끓어올라(賁) '분하다'."},
{"c":"富","m":"부, 넉넉하다","s":"집(宀) 안에 밭(田)과 술병이 가득 → '부자'."},
{"c":"治","m":"다스리다, 낫다, 고치다","s":"물(氵)을 잘 이끌어(台) '다스린다', 병이 '낫는다'."},
{"c":"癒","m":"낫다, 치유되다","s":"병(疒)이 점점 나아(愈) '치유된다'."},
{"c":"旺","m":"왕성하다","s":"해(日)가 임금(王)처럼 기세 '왕성하다'."},
{"c":"寡","m":"적다, 과묵하다","s":"집(宀) 안에 혼자 남아 머리(頁)를 숙이니 말이 '적다'."},
{"c":"糾","m":"꼬다, 따지다, 규명","s":"실(糸)을 꼬아(丩) 얽힌 일을 '따진다'."},
{"c":"乱","m":"어지럽다, 흐트러지다","s":"혀(舌)가 꼬인(乚) 듯 말이 '어지럽다'."},
{"c":"模","m":"본뜨다, 모형","s":"나무(木)로 해 질 녘(莫) 모양을 '본뜬다'."},
{"c":"貢","m":"바치다, 공헌","s":"만든(工) 물건과 돈(貝)을 '바친다'."},
{"c":"献","m":"바치다, 드리다","s":"남쪽(南) 개(犬)를 제사에 '바친다'."},
{"c":"滅","m":"멸망하다, 없애다","s":"물(氵)을 부어 불을 '꺼 없앤다'."},
{"c":"素","m":"바탕, 본디, 소박하다","s":"실(糸)의 처음 그대로 → '바탕, 소박'."},
{"c":"露","m":"이슬, 드러나다","s":"비(雨) 내린 길(路)에 맺힌 '이슬', 그리고 '드러나다'."},
{"c":"渇","m":"목마르다","s":"물(氵)이 다해(曷) '목마르다'."},
{"c":"克","m":"이기다, 극복하다","s":"무거운 투구를 쓰고 끝까지 견뎌 '이긴다'."},
{"c":"存","m":"있다, 알다(겸손), 보존","s":"아이(子)가 그 자리에 계속 '있다'."},
{"c":"賛","m":"돕다, 찬성하다","s":"두 사람이 돈(貝)을 내어 '돕는다' → '찬성'."},
{"c":"拗","m":"비틀리다, 꼬이다(拗れる)","s":"손(扌)으로 어리게(幼) 비틀어 일이 '꼬인다'."},
{"c":"馬","m":"말","s":"갈기와 네 다리가 있는 '말'."},
{"c":"等","m":"같다, 등급, ~등","s":"대나무(竹) 조각을 절(寺)에서 '같게' 정리한다."},
{"c":"押","m":"누르다, 밀다","s":"손(扌)으로 갑옷(甲)을 '누른다'."},
{"c":"秘","m":"비밀, 숨기다","s":"벼(禾)를 반드시(必) 감춰 두는 '비밀'."},
{"c":"潤","m":"윤택하다, 축축하다","s":"물(氵)이 문(門) 안 임금(王)까지 '적신다'."},
{"c":"推","m":"밀다, 추측하다, 추천하다","s":"손(扌)으로 새(隹)를 '밀어' 날린다."},
{"c":"壊","m":"부수다, 부서지다","s":"흙(土)벽이 품은(褱) 무게에 '무너진다'."},
{"c":"薄","m":"얇다, 연하다","s":"풀(艹)잎처럼 물(氵)에 '얇게' 퍼진다."},
{"c":"華","m":"화려하다, 꽃","s":"풀(艹) 위에 꽃이 늘어진 '화려한' 모습."},
{"c":"繁","s":"실(糸)이 엉키도록 바쁘게(敏) 늘어나 '번성한다'."},
{"c":"伴","m":"짝, 동반하다","s":"사람(亻)과 반(半)쪽이 만나 '함께한다'."},
{"c":"筋","m":"힘줄, 줄거리, 근육","s":"대나무(竹) 같은 몸(月)의 힘(力) → '힘줄'."},
{"c":"覧","m":"보다, 두루 보다","s":"내려다보며 두루 '본다(見)'."},
{"c":"考","m":"생각하다","s":"늙은이(耂)가 오래 '생각한다'."},
{"c":"釈","m":"풀다, 설명하다","s":"쌀(米)을 자(尺)로 재듯 하나하나 '풀어 설명한다'."},
{"c":"漠","s":"물(氵)이 사라진(莫) 넓은 땅 → '사막, 막연하다'."},
{"c":"利","m":"이익, 이롭다, 듣다(효과)","s":"벼(禾)를 칼(刂)로 베어 얻는 '이익'."},
{"c":"益","m":"이익, 더하다","s":"그릇(皿) 위로 물이 넘쳐 '더해진다' → '이익'."},
{"c":"革","m":"가죽, 고치다(개혁)","s":"짐승 가죽을 쫙 펼친 모양 → '가죽', 바꾸는 '개혁'."},
{"c":"覆","s":"덮개(覀)로 다시(復) 덮어 '뒤집는다, 덮는다'."},
{"c":"群","m":"무리, 떼","s":"임금(君) 주변에 양(羊)이 모인 '무리'."},
{"c":"衆","m":"무리, 많은 사람","s":"피(血) 아래 사람들이 모인 '무리'."},
{"c":"踏","m":"밟다","s":"발(⻊)로 물(水) 위 해(日)를 '밟는다'."},
{"c":"襲","m":"습격하다, 이어받다","s":"용(龍)이 옷(衣)을 덮치듯 '습격한다'."},
{"c":"誉","m":"명예, 칭찬하다","s":"말(言)로 높이 들어 올리는 '명예'."},
{"c":"網","m":"그물, 망","s":"실(糸)로 엮은 '그물'."},
{"c":"羅","m":"벌이다, 늘어놓다(網羅)","s":"그물(罒)에 실(糸)과 새(隹)를 '늘어놓는다'."},
{"c":"枠","m":"테두리, 틀, 범위","s":"나무(木)로 끝(卆)을 두른 '틀'. 일본에서 만든 한자예요."},
{"c":"憩","m":"쉬다, 휴식","s":"혀(舌)를 쉬고 마음(心)도 '쉰다'."},
{"c":"巧","m":"교묘하다, 솜씨 좋다","s":"공구(工)를 솜씨 있게 다루니 '교묘하다'."},
{"c":"妙","m":"묘하다, 신기하다","s":"여자(女)가 젊고(少) '묘하게' 아름답다."},
{"c":"趣","m":"멋, 취미, 취지","s":"달려가(走) 취하고(取) 싶은 '멋'."},
{"c":"旨","m":"뜻, 취지, 맛있다","s":"숟가락(匕)으로 해(日)처럼 맛있는 것을 뜬다 → '맛, 뜻'."},
{"c":"需","m":"구하다, 수요","s":"비(雨)를 기다리며 '구한다' → '수요'."},
{"c":"貫","m":"꿰뚫다, 관철하다","s":"돈(貝)을 끈으로 '꿰뚫는다'."},
{"c":"夜","m":"밤","s":"지붕(亠) 아래 사람(亻)이 저녁(夕)을 지나 '밤'을 맞는다."},
{"c":"把","s":"손(扌)으로 꽉 '잡는다' → '파악'."},
{"c":"否","m":"아니다, 부정하다","s":"입(口)으로 '아니(不)'라고 말한다."},
{"c":"概","m":"대개, 대략","s":"나무(木) 표면을 대충 깎아 '대략' 모양을 낸다."},
{"c":"略","m":"간략하다, 줄이다, 빼앗다","s":"밭(田)마다 각각(各) '간략히' 나눈다."},
{"c":"凝","m":"엉기다, 굳다, 집중하다","s":"얼음(冫)처럼 의심(疑)할 만큼 단단히 '엉긴다'."},
{"c":"厳","m":"엄하다, 엄격하다","s":"언덕(厂) 위에서 감히(敢) 꾸짖으니 '엄하다'."},
{"c":"拒","m":"거부하다, 막다","s":"손(扌)을 크게(巨) 내밀어 '거절한다'."},
{"c":"遂","m":"이루다, 드디어","s":"길(辶)을 돼지(豕)처럼 우직하게 가서 '이룬다'."},
{"c":"漂","m":"떠돌다, 표류하다","s":"물(氵) 위에 표(票)가 '둥둥 뜬다'."},
{"c":"枢","m":"중심, 지도리","s":"나무(木) 문의 중심 '지도리' → '중추'."},
{"c":"促","m":"재촉하다, 촉진","s":"사람(亻)의 발(足)을 '재촉한다'."},
{"c":"躍","m":"뛰다, 활약하다","s":"발(⻊)로 새처럼 높이 '뛴다'."},
{"c":"淡","m":"엷다, 담백하다","s":"물(氵)에 불(炎)기를 식혀 맛이 '담백하다'."},
{"c":"随","m":"따르다, 수시로","s":"언덕(⻖)길을 그대로 '따라간다'."},
{"c":"添","m":"덧붙이다, 곁들이다","s":"물(氵)을 조금 더해 '곁들인다'."},
{"c":"唱","m":"부르다, 외치다","s":"입(口)으로 해(日)처럼 밝게 노래를 '부른다'."},
{"c":"励","m":"힘쓰다, 격려하다","s":"힘(力)을 다해 '힘쓰도록' 북돋운다."},
{"c":"損","m":"손해, 덜다, 해치다","s":"손(扌)에서 돈(貝)이 빠져나가는 '손해'."},
{"c":"遷","m":"옮기다, 변천","s":"길(辶)을 따라 자리를 '옮긴다'."},
{"c":"賢","m":"현명하다, 어질다","s":"단단한(臤) 마음으로 돈(貝)을 다루니 '현명하다'."},
{"c":"鑑","m":"거울, 본보기, 감상하다","s":"쇠(金) 거울로 비추어 '살핀다(監)'."},
{"c":"著","s":"풀(艹) 위에 사람(者)이 이름을 '드러낸다' → '저술하다, 현저하다'."},
{"c":"樹","m":"나무, 세우다","s":"나무(木)를 북(壴)처럼 곧게 '세운다'."},
{"c":"木","m":"나무","s":"가지와 뿌리가 있는 '나무'."},
{"c":"脈","m":"맥, 줄기, 혈관","s":"몸(月) 안에서 갈래로 흐르는 '맥'."},
{"c":"廃","m":"폐지하다, 버리다","s":"집(广)을 떠나며(発) '버린다'."},
{"c":"岐","m":"갈림길, 갈라지다","s":"산(山)길이 가지(支)처럼 '갈라진다'."},
{"c":"蓄","m":"쌓다, 모으다, 저축","s":"풀(艹) 아래 기르는(畜) 것을 '모아 둔다'."},
{"c":"陳","m":"늘어놓다, 진열하다","s":"언덕(⻖) 동쪽(東)에 물건을 '늘어놓는다'."},
{"c":"斜","m":"비스듬하다, 기울다","s":"남은(余) 것을 말(斗)로 '비스듬히' 따른다."},
{"c":"殺","m":"죽이다, 없애다","s":"몽둥이(殳)를 휘둘러 '죽인다'."},
{"c":"菌","m":"균, 세균","s":"풀(艹) 아래 곳간(囷)에 피는 '균'."},
{"c":"暴","m":"사납다, 폭력, 날뛰다","s":"해(日) 아래 물(水)을 사납게 끼얹으며 '날뛴다'."},
{"c":"開","m":"열다, 열리다","s":"문(門)의 빗장을 두 손으로 '연다'."}
]
