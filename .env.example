# .env 예시 파일 — 어떤 값이 필요한지 보여 주기 위한 파일 (실제 값은 넣지 않는다)
# 사용법: 이 파일을 복사해 이름을 .env로 바꾼 뒤, 등호(=) 뒤에 값을 채운다.
# .env는 GitHub에 올라가지 않는다. 이 예시 파일만 올라간다.

# [카카오 개발자 > 앱 키] REST API 키 — Supabase Kakao 설정의 Client ID
KAKAO_REST_API_KEY=

# [카카오 개발자 > 앱 키] JavaScript 키
KAKAO_JAVASCRIPT_KEY=

# [카카오 로그인 > 보안] Client Secret 코드 — Supabase Kakao 설정의 Client Secret (비밀)
KAKAO_CLIENT_SECRET=

# 로그인 후 카카오가 돌려보낼 주소. Supabase를 거치면 https://<Supabase 프로젝트 주소>/auth/v1/callback
KAKAO_REDIRECT_URI=

# 카카오 계정까지 로그아웃한 뒤 돌아올 사이트 주소 (예: https://<사이트이름>.netlify.app/)
KAKAO_LOGOUT_REDIRECT_URI=
